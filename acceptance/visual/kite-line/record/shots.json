{
 "version": 1,
 "product": "game",
 "viewports": [
  "phone",
  "desktop"
 ],
 "shots": [
  {
   "id": "title",
   "name": "Title: the kite climbs off the hand and lands beside the wordmark",
   "kind": "title",
   "moment": "title-reveal",
   "steps": [],
   "sequence": {
    "after_ms": 600
   },
   "wait_for": {
    "selector": "#title[data-ready]",
    "timeout_ms": 8000
   }
  },
  {
   "id": "mid-play",
   "name": "Mid-play, climbing after the first ribbons",
   "kind": "play",
   "steps": [
    {
     "press": "Space"
    },
    {
     "wait": 2600
    },
    {
     "hold": {
      "key": "Space",
      "ms": 330
     }
    },
    {
     "wait": 250
    },
    {
     "hold": {
      "key": "Space",
      "ms": 260
     }
    }
   ],
   "wait_for": {
    "js": "window.__game.state === 'playing' && window.__game.time > 2.2",
    "timeout_ms": 8000
   }
  },
  {
   "id": "first-ribbon",
   "name": "First ribbon: the page celebrates",
   "kind": "moment",
   "moment": "first-ribbon",
   "steps": [
    {
     "press": "Space"
    },
    {
     "wait": 700
    }
   ],
   "sequence": {
    "after_ms": 1700
   },
   "wait_for": {
    "js": "window.__game.first_ribbon_at !== null && !!window.__game.note",
    "timeout_ms": 8000
   },
   "settle_ms": 420
  },
  {
   "id": "fail",
   "name": "The instant of failing: the kite hits the ground",
   "kind": "fail",
   "steps": [
    {
     "press": "Space"
    }
   ],
   "wait_for": {
    "js": "window.__game.state === 'failing'",
    "timeout_ms": 15000
   },
   "settle_ms": 260
  },
  {
   "id": "results",
   "name": "The flight log at night, fully drawn",
   "kind": "results",
   "moment": "results",
   "steps": [
    {
     "press": "Space"
    }
   ],
   "sequence": {
    "before": {
     "js": "window.__game.state === 'failing'",
     "timeout_ms": 15000
    },
    "after_ms": 300
   },
   "wait_for": {
    "js": "window.__game.state === 'over' && window.__game.results_drawn === true",
    "timeout_ms": 18000
   }
  },
  {
   "id": "paused",
   "name": "Paused",
   "kind": "screen",
   "steps": [
    {
     "press": "Space"
    },
    {
     "wait": 700
    },
    {
     "press": "KeyP"
    }
   ],
   "wait_for": {
    "selector": "#paused:not([hidden])",
    "timeout_ms": 5000
   }
  }
 ]
}