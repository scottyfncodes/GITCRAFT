 "routes": [
  {
   "id": "photogrammetry",
   "when": "images>=8 or intent:photogrammetry and images>=1",
   "tools": [
    "meshroom",
    "triposr",
    "hunyuan3d"
   ],
   "why": "Several photos of a real object or place: reconstruct the actual geometry instead of inventing it."
  },
  {
   "id": "concept_image",
   "when": "images>=1 and intent:concept_art",
   "tools": [
    "hunyuan3d",
    "triposr"
   ],
   "why": "Detailed concept art: Hunyuan3D gives the most faithful shape and texture; TripoSR is the faster fallback."
  },
  {
   "id": "photo_image",
   "when": "images>=1",
   "tools": [
    "triposr",
    "hunyuan3d"
   ],
   "why": "One reference image: TripoSR converts a single photo to a mesh in seconds on a GPU (minutes on CPU)."
  },
  {
   "id": "scene",
   "when": "intent:scene or kind:scene",
   "tools": [
    "blender_scene"
   ],
   "why": "Scene assembly, lighting and composition are Blender's job."
  },
  {
   "id": "voxel",
   "when": "intent:voxel",
   "tools": [
    "blockbench",
    "blender_procedural"
   ],
   "why": "Blocky / voxel style is Blockbench's format; the .bbmodel stays hand-editable in Blockbench."
  },
  {
   "id": "character",
   "when": "intent:character or kind:character",
   "tools": [
    "blender_character",
    "hunyuan3d"
   ],
   "why": "Animated characters need a skeleton: Blender builds a Mixamo-compatible rig and clips; Mixamo downloads can be layered on."
  },
  {
   "id": "creature",
   "when": "intent:creature",
   "tools": [
    "blockbench",
    "hunyuan3d"
   ],
   "why": "Non-humanoid creatures: a Blockbench cube-built model (stylized) or Hunyuan3D for organic detail. The humanoid Mixamo rig is not used for creatures."
  },
  {
   "id": "procedural",
   "when": "kind:known",
   "tools": [
    "blender_procedural",
    "blockbench",
    "hunyuan3d"
   ],
   "why": "A stylized game asset of a known type: Blender's procedural modelling is fast, deterministic and free."
  },
  {
   "id": "detailed_text",
   "when": "true",
   "tools": [
    "hunyuan3d",
    "blender_procedural",
    "blockbench"
   ],
   "why": "Free-form description with no template: text-to-3D (Hunyuan3D) when compute allows."
  }
 ],
 "tools": {
  "blender_procedural": {
   "label": "Blender (procedural)",
   "backend": "blender",
   "needs": "kind:known",
   "kinds": [
    "boat",
    "upgrade",
    "salvage",
    "island",
    "lighthouse",
    "prop"
   ],
   "compute": "CPU, seconds"
  },
  "blender_character": {
   "label": "Blender (rig + animation, Mixamo skeleton)",
   "backend": "blender",
   "compute": "CPU, seconds"
  },
  "blender_scene": {
   "label": "Blender (scene composition)",
   "backend": "blender",
   "compute": "CPU, ~1 min with hero render"
  },
  "blockbench": {
   "label": "Blockbench (.bbmodel) → Blender",
   "backend": "blender",
   "needs": "bb_template",
   "kinds": [
    "boat",
    "prop",
    "salvage",
    "character",
    "crab",
    "lantern"
   ],
   "compute": "CPU, seconds"
  },
  "triposr": {
   "label": "TripoSR (image → mesh)",
   "backend": "triposr",
   "needs": "image",
   "compute": "GPU ~6 GB VRAM: ~1 s; CPU: minutes"
  },
  "hunyuan3d": {
   "label": "Hunyuan3D-2 (text/image → textured mesh)",
   "backend": "hunyuan3d",
   "compute": "NVIDIA GPU ≥6 GB (shape) / ≥16 GB (texture), or HF Space"
  },
  "meshroom": {
   "label": "Meshroom / AliceVision (photogrammetry)",
   "backend": "meshroom",
   "needs": "images>=3",
   "compute": "CPU draft: 5–30 min; CUDA for dense"
  },
  "import": {
   "label": "Import existing mesh → Blender",
   "backend": "blender",
   "compute": "CPU, seconds"
  },
  "mixamo": {
   "label": "Mixamo FBX animations → Blender",
   "backend": "blender",
   "compute": "CPU, seconds"
  }
 }
}