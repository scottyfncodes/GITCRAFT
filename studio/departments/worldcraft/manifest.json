{
 "name": "worldcraft",
 "version": "1.0.0",
 "title": "WorldCraft — procedural environments",
 "summary": "Terrains (island, archipelago, atoll, coast, mountains, canyon, volcano, plains) with hydraulic + thermal erosion, biomes, 16-bit heightmaps, normal/splat/biome maps and masks, vegetation and rock scatter, coastlines and a vertex-coloured GLB; caves (surface-nets meshes); physical skies (Blender Nishita) as equirect + HDR + cubemap with sun lighting; seamless time-looping FFT oceans; rule-based scatter on any heightmap.",
 "keywords": [
  "terrain",
  "island",
  "archipelago",
  "atoll",
  "coastline",
  "coast",
  "mountain",
  "mountains",
  "canyon",
  "volcano",
  "landscape",
  "heightmap",
  "height map",
  "splatmap",
  "splat map",
  "biome",
  "biomes",
  "erosion",
  "cave",
  "caves",
  "tunnel",
  "sky",
  "skybox",
  "cubemap",
  "hdri",
  "environment map",
  "ocean",
  "sea",
  "waves",
  "water surface",
  "vegetation",
  "scatter",
  "foliage",
  "rocks",
  "world",
  "environment"
 ],
 "output_license": "Generated by GITCRAFT; owned by the requesting project",
 "tools": {
  "studio_world": {
   "name": "GITCRAFT WorldCraft generators (noise, erosion, biomes, scatter, surface nets, FFT ocean)",
   "license": "same as GITCRAFT",
   "version": "1.0",
   "source": "studio/departments/worldcraft/terrain.py"
  },
  "numpy": {
   "name": "NumPy",
   "license": "BSD-3-Clause",
   "version": "2.5.4"
  },
  "blender": {
   "name": "Blender 5.2 (bpy, MeshCraft's) — Nishita sky texture, Cycles",
   "license": "GPL-2.0-or-later (outputs are not covered)",
   "version": "5.2.3"
  },
  "three": {
   "name": "three.js r170 (engine check)",
   "license": "MIT",
   "version": "0.170.0"
  },
  "gltf_validator": {
   "name": "Khronos glTF-Validator",
   "license": "Apache-2.0",
   "version": "2.0.0-dev.3.10"
  },
  "cc0_sources": {
   "name": "CC0 libraries: Poly Haven (api.polyhaven.com) and ambientCG (ambientcg.com)",
   "license": "CC0-1.0 (assets); GITCRAFT client code",
   "version": "API v1 / v2",
   "source": "studio/core/sources.py"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "blender": {
   "kind": "blender",
   "license": "GPL-2.0-or-later",
   "install": "scripts/install.sh meshcraft",
   "alternatives": [
    "sky engine: analytic (gradient approximation)"
   ]
  },
  "three": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/three",
   "license": "MIT",
   "install": "scripts/install-studio.sh"
  },
  "gltf_validator": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/gltf-validator",
   "license": "Apache-2.0",
   "install": "scripts/install-studio.sh"
  },
  "browser": {
   "kind": "playwright",
   "license": "Apache-2.0 (Playwright), BSD (Chromium)",
   "install": "npm i -g playwright && npx playwright install chromium"
  },
  "cc0_sources": {
   "kind": "hosts",
   "hosts": [
    "api.polyhaven.com",
    "dl.polyhaven.org",
    "ambientcg.com",
    "acg-download.struffelproductions.com"
   ],
   "license": "CC0-1.0",
   "install": "GITCRAFT setup adds these hosts to ~/.gitcraft/allow-hosts for studiocraft; the environment's network policy must allow them too",
   "alternatives": [
    "procedural actions (materialcraft_generate, worldcraft_sky)"
   ]
  }
 },
 "actions": {
  "terrain": {
   "summary": "Generate a terrain with erosion, biomes, maps, masks, scatter, coastline and a GLB (engine-checked).",
   "requires": [
    "numpy",
    "pillow",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "preset": {
      "type": "string",
      "default": "island",
      "enum": [
       "island",
       "archipelago",
       "mountains",
       "canyon",
       "plains",
       "volcano",
       "coast",
       "atoll"
      ]
     },
     "resolution": {
      "type": "integer",
      "default": 257,
      "minimum": 65,
      "maximum": 1025,
      "description": "heightmap cells per side (2^n+1 suits Unity/Godot)"
     },
     "mesh_resolution": {
      "type": "integer",
      "default": 129,
      "minimum": 17,
      "maximum": 513
     },
     "world_size": {
      "type": "number",
      "minimum": 16,
      "description": "metres per side (default per preset: island 512, mountains 3000, volcano 2400, canyon 1200)"
     },
     "height_scale": {
      "type": "number",
      "minimum": 1,
      "description": "metres from lowest to highest point (default per preset: island 45, mountains 450, volcano 280, canyon 120, plains 30)"
     },
     "sea_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.95,
      "description": "0..1 of the height range (default 0.32 for coastal presets, 0 inland)"
     },
     "roughness": {
      "type": "number",
      "default": 0.5,
      "minimum": 0,
      "maximum": 1
     },
     "erosion": {
      "type": "integer",
      "default": 12,
      "minimum": 0,
      "maximum": 60,
      "description": "hydraulic erosion iterations"
     },
     "erosion_strength": {
      "type": "number",
      "default": 0.5,
      "minimum": 0,
      "maximum": 3
     },
     "thermal": {
      "type": "integer",
      "default": 20,
      "minimum": 0,
      "maximum": 200
     },
     "climate": {
      "type": "string",
      "default": "temperate",
      "enum": [
       "tropical",
       "temperate",
       "arid",
       "cold"
      ]
     },
     "vegetation": {
      "type": "number",
      "default": 1.0,
      "minimum": 0,
      "maximum": 3
     },
     "tree_spacing": {
      "type": "number",
      "default": 6,
      "minimum": 0.5
     },
     "rocks": {
      "type": "number",
      "default": 0.6,
      "minimum": 0,
      "maximum": 1
     },
     "rock_spacing": {
      "type": "number",
      "default": 10,
      "minimum": 0.5
     }
    }
   },
   "outputs": [
    "_height16.png",
    "_normal.png",
    "_splat.png (RGBA sand/grass/rock/snow)",
    "_biomes.png",
    "_preview.png",
    "masks/*.png",
    "_scatter.json",
    "_coastline.json",
    ".glb",
    ".terrain.json",
    "_engine.png"
   ],
   "keywords": [
    "terrain",
    "island",
    "landscape",
    "heightmap",
    "mountains",
    "biomes"
   ]
  },
  "caves": {
   "summary": "A cave system (worm tunnels + noise chambers) as a closed surface-nets mesh GLB.",
   "requires": [
    "numpy",
    "pillow",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "resolution": {
      "type": "integer",
      "default": 64,
      "minimum": 24,
      "maximum": 160
     },
     "size": {
      "type": "number",
      "default": 60
     },
     "tunnels": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 20
     },
     "radius": {
      "type": "number",
      "default": 0.07,
      "minimum": 0.02,
      "maximum": 0.2
     }
    }
   },
   "keywords": [
    "cave",
    "caves",
    "tunnels",
    "cavern"
   ]
  },
  "sky": {
   "summary": "A physical sky (Blender Nishita) as equirect PNG + EXR, a six-face cubemap (three.js order) and sun/ambient lighting values.",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "properties": {
     "preset": {
      "type": "string",
      "default": "noon",
      "enum": [
       "noon",
       "morning",
       "sunset",
       "dusk",
       "overcast",
       "night"
      ]
     },
     "sun_elevation": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
     },
     "sun_azimuth": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
     },
     "engine": {
      "type": "string",
      "default": "auto",
      "enum": [
       "auto",
       "blender",
       "analytic"
      ]
     },
     "width": {
      "type": "integer",
      "default": 1024,
      "minimum": 256,
      "maximum": 4096
     },
     "cube_size": {
      "type": "integer",
      "default": 256,
      "minimum": 64,
      "maximum": 2048
     },
     "hdr": {
      "type": "boolean",
      "default": true
     },
     "air": {
      "type": "number",
      "default": 1.0
     },
     "dust": {
      "type": "number",
      "default": 1.0
     },
     "ozone": {
      "type": "number",
      "default": 1.0
     },
     "strength": {
      "type": "number",
      "default": 0.35
     }
    }
   },
   "keywords": [
    "sky",
    "skybox",
    "cubemap",
    "environment map"
   ]
  },
  "ocean": {
   "summary": "A Tessendorf FFT ocean that loops in time and tiles in space: normal and foam flipbooks, height, a displaced tile GLB, playback spec.",
   "requires": [
    "numpy",
    "pillow",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "resolution": {
      "type": "integer",
      "default": 128,
      "enum": [
       32,
       64,
       128,
       256,
       512
      ]
     },
     "tile_size": {
      "type": "number",
      "default": 48
     },
     "wind": {
      "type": "number",
      "default": 9,
      "minimum": 1,
      "maximum": 30
     },
     "direction": {
      "type": "number",
      "default": 30
     },
     "period": {
      "type": "number",
      "default": 8,
      "minimum": 1
     },
     "frames": {
      "type": "integer",
      "default": 32,
      "minimum": 4,
      "maximum": 128
     },
     "choppiness": {
      "type": "number",
      "default": 1.0,
      "minimum": 0,
      "maximum": 3
     },
     "amplitude": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.1,
      "maximum": 4
     }
    }
   },
   "keywords": [
    "ocean",
    "sea",
    "waves",
    "water surface"
   ]
  },
  "scatter": {
   "summary": "Place instances on any 16-bit heightmap by rules (spacing, height and slope ranges, density, scale).",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "required": [
     "heightmap",
     "rules"
    ],
    "properties": {
     "heightmap": {
      "type": "string"
     },
     "world_size": {
      "type": "number",
      "default": 512
     },
     "height_scale": {
      "type": "number",
      "default": 60
     },
     "rules": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "kind"
       ],
       "properties": {
        "kind": {
         "type": "string"
        },
        "spacing": {
         "type": "number"
        },
        "min_height": {
         "type": "number"
        },
        "max_height": {
         "type": "number"
        },
        "min_slope": {
         "type": "number"
        },
        "max_slope": {
         "type": "number"
        },
        "density": {
         "type": "number"
        },
        "scale": {
         "type": "array"
        }
       }
      }
     }
    }
   },
   "keywords": [
    "scatter",
    "place trees",
    "vegetation placement",
    "foliage"
   ]
  },
  "hdri": {
   "summary": "A CC0 HDRI sky/environment from Poly Haven by search words or id: the .hdr (checksummed), a tone-mapped equirect preview, a 6-face cubemap and lighting values (sun direction, ambient colour). Licence CC0, credit recorded.",
   "requires": [
    "numpy",
    "pillow",
    "cc0_sources"
   ],
   "params": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "e.g. 'snowy mountain', 'overcast sea', 'sunset pure sky'"
     },
     "id": {
      "type": "string"
     },
     "resolution": {
      "type": "string",
      "enum": [
       "1k",
       "2k",
       "4k"
      ],
      "default": "1k"
     },
     "exposure": {
      "type": "number",
      "default": 0.0,
      "description": "stops applied to the LDR preview/cubemap"
     },
     "cube_size": {
      "type": "integer",
      "default": 512,
      "minimum": 64,
      "maximum": 2048
     },
     "list_only": {
      "type": "boolean",
      "default": false
     },
     "candidates": {
      "type": "integer",
      "default": 6,
      "minimum": 1,
      "maximum": 20
     }
    }
   },
   "outputs": [
    "<name>.hdr",
    "<name>_equirect.png",
    "cubemap/<name>_{px,nx,py,ny,pz,nz}.png",
    "<name>.sky.json"
   ],
   "keywords": [
    "hdri",
    "hdr sky",
    "environment map",
    "poly haven",
    "polyhaven",
    "real sky",
    "photo sky",
    "image based lighting",
    "ibl",
    "cc0",
    "download",
    "photo",
    "real hdri",
    "photographed sky"
   ]
  },
  "fetch_model": {
   "summary": "A CC0 3D model from Poly Haven by search words or id (props, nature, furniture): downloaded with its textures (checksummed), packed into one GLB, Khronos-validated and rendered in three.js. Licence CC0, credit recorded.",
   "requires": [
    "numpy",
    "pillow",
    "cc0_sources",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "e.g. 'pine tree', 'wooden crate', 'rock boulder'"
     },
     "id": {
      "type": "string"
     },
     "resolution": {
      "type": "string",
      "enum": [
       "1k",
       "2k",
       "4k"
      ],
      "default": "1k",
      "description": "texture resolution"
     },
     "list_only": {
      "type": "boolean",
      "default": false
     },
     "candidates": {
      "type": "integer",
      "default": 6,
      "minimum": 1,
      "maximum": 20
     },
     "max_mb": {
      "type": "integer",
      "default": 40,
      "minimum": 1,
      "maximum": 1024,
      "description": "download budget for mesh + textures; larger matches are skipped"
     }
    }
   },
   "outputs": [
    "<name>.glb",
    "<name>_render.png"
   ],
   "keywords": [
    "poly haven model",
    "cc0 model",
    "download model",
    "free 3d model",
    "scanned prop",
    "photoscanned",
    "cc0",
    "download",
    "scanned",
    "poly haven",
    "polyhaven",
    "free model"
   ]
  }
 },
 "examples": [
  {
   "ask": "A tropical island for my pirate game",
   "call": {
    "action": "terrain",
    "params": {
     "preset": "island",
     "climate": "tropical",
     "world_size": 400,
     "height_scale": 45
    }
   }
  },
  {
   "ask": "Sunset skybox",
   "call": {
    "action": "sky",
    "params": {
     "preset": "sunset"
    }
   }
  },
  {
   "ask": "Animated ocean normal maps",
   "call": {
    "action": "ocean",
    "params": {
     "wind": 12,
     "period": 6
    }
   }
  }
 ],
 "limits": [
  "Erosion is a fast stream-power approximation, not a full sediment simulation; for film-grade landscapes, Infinigen is the deferred alternative.",
  "Caves are one closed mesh (no LODs or collision split).",
  "Sky night preset adds a seeded starfield; there is no moon or Milky Way."
 ]
}
