{
 "name": "cinematiccraft",
 "version": "1.0.0",
 "title": "CinematicCraft — cinematics and video",
 "summary": "Camera choreography (orbit, dolly in/out, crane up, flyby, push-in zoom, handheld, static) over any GLB/FBX/OBJ/.blend scene with lighting presets (studio three-point, golden hour, night, overcast, dramatic, daylight) and optional HDR/equirect sky, rendered with Cycles to MP4 + editable .blend + an engine camera path (JSON) for in-game cutscenes; storyboards (PNG + PDF); animated title cards; trailer assembly with crossfades and a loudness-normalised music bed; gameplay capture from a web game.",
 "keywords": [
  "cinematic",
  "cinematics",
  "cutscene",
  "cut scene",
  "camera",
  "camera move",
  "orbit",
  "turntable",
  "dolly",
  "crane",
  "flyby",
  "fly-through",
  "storyboard",
  "trailer",
  "teaser",
  "title card",
  "title",
  "intro",
  "video",
  "mp4",
  "render",
  "rendered",
  "lighting",
  "golden hour",
  "gameplay capture",
  "screen recording",
  "record gameplay",
  "edit",
  "montage"
 ],
 "output_license": "Generated by GITCRAFT; owned by the requesting project (clips and music keep their own licences)",
 "tools": {
  "blender": {
   "name": "Blender 5.2 (bpy, MeshCraft's) — cameras, lights, Cycles, OpenImageDenoise",
   "license": "GPL-2.0-or-later (renders are not covered)",
   "version": "5.2.3"
  },
  "ffmpeg": {
   "name": "FFmpeg (x264, AAC, xfade, loudnorm)",
   "license": "GPL-2.0+ build (x264 is GPL)",
   "version": "system"
  },
  "studio_cine": {
   "name": "GITCRAFT CinematicCraft (camera moves, title renderer)",
   "license": "same as GITCRAFT",
   "version": "1.0"
  },
  "playwright": {
   "name": "Playwright + Chromium (capture)",
   "license": "Apache-2.0 / BSD",
   "version": "preinstalled"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "blender": {
   "kind": "blender",
   "license": "GPL-2.0-or-later",
   "install": "scripts/install.sh meshcraft"
  },
  "ffmpeg": {
   "kind": "binary",
   "bin": "ffmpeg",
   "license": "LGPL/GPL",
   "install": "apt-get install ffmpeg"
  },
  "browser": {
   "kind": "playwright",
   "license": "Apache-2.0 (Playwright), BSD (Chromium)",
   "install": "npm i -g playwright && npx playwright install chromium"
  }
 },
 "actions": {
  "shot": {
   "summary": "Stage, light and render a camera move over a scene: MP4, .blend, camera path JSON (Y-up) for engines, stills, contact sheet.",
   "requires": [
    "numpy",
    "pillow",
    "blender",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "properties": {
     "input": {
      "type": "string"
     },
     "scene": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "path"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "location": {
         "type": "array"
        },
        "scale": {
         "type": "number"
        },
        "rotation_z": {
         "type": "number"
        }
       }
      }
     },
     "move": {
      "type": "string",
      "default": "orbit",
      "enum": [
       "orbit",
       "dolly_in",
       "dolly_out",
       "crane_up",
       "flyby",
       "push_in",
       "handheld",
       "static"
      ]
     },
     "lighting": {
      "type": "string",
      "default": "golden_hour",
      "enum": [
       "studio",
       "golden_hour",
       "night",
       "overcast",
       "dramatic",
       "daylight"
      ]
     },
     "duration": {
      "type": "number",
      "default": 3,
      "minimum": 0.5,
      "maximum": 60
     },
     "fps": {
      "type": "integer",
      "default": 24,
      "enum": [
       12,
       24,
       25,
       30,
       60
      ]
     },
     "resolution": {
      "type": "array",
      "default": [
       640,
       360
      ],
      "items": {
       "type": "integer"
      }
     },
     "samples": {
      "type": "integer",
      "default": 12,
      "minimum": 1,
      "maximum": 512
     },
     "distance": {
      "type": "number",
      "default": 3.0,
      "description": "× scene radius"
     },
     "height": {
      "type": "number",
      "default": 0.8,
      "description": "× scene radius"
     },
     "arc": {
      "type": "number",
      "description": "orbit/arc degrees"
     },
     "start_angle": {
      "type": "number",
      "default": -30
     },
     "lens": {
      "type": "number",
      "default": 35
     },
     "sky": {
      "type": "string",
      "description": "equirect PNG/EXR (e.g. from worldcraft sky) as background and light"
     },
     "ground": {
      "type": "boolean",
      "default": true
     }
    }
   },
   "keywords": [
    "cutscene",
    "camera move",
    "orbit",
    "dolly",
    "flyby",
    "crane",
    "render a shot",
    "turntable"
   ]
  },
  "storyboard": {
   "summary": "A storyboard sheet (PNG + PDF): one rendered still per shot from the scene, or given images, with captions.",
   "requires": [
    "pillow",
    "blender"
   ],
   "params": {
    "type": "object",
    "required": [
     "shots"
    ],
    "properties": {
     "input": {
      "type": "string"
     },
     "scene": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "title": {
      "type": "string"
     },
     "shots": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "caption": {
         "type": "string"
        },
        "move": {
         "type": "string"
        },
        "seconds": {
         "type": "number"
        },
        "image": {
         "type": "string"
        },
        "start_angle": {
         "type": "number"
        },
        "distance": {
         "type": "number"
        },
        "height": {
         "type": "number"
        },
        "lens": {
         "type": "number"
        },
        "frame": {
         "type": "integer"
        }
       }
      }
     },
     "lighting": {
      "type": "string",
      "default": "golden_hour"
     },
     "samples": {
      "type": "integer",
      "default": 8
     },
     "columns": {
      "type": "integer",
      "default": 3,
      "minimum": 1,
      "maximum": 6
     }
    }
   },
   "keywords": [
    "storyboard"
   ]
  },
  "title_card": {
   "summary": "An animated title card (fade, rise, scale or typewriter) as MP4 + still.",
   "requires": [
    "numpy",
    "pillow",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "subtitle": {
      "type": "string"
     },
     "style": {
      "type": "string",
      "default": "rise",
      "enum": [
       "fade",
       "rise",
       "scale",
       "typewriter"
      ]
     },
     "duration": {
      "type": "number",
      "default": 3
     },
     "fps": {
      "type": "integer",
      "default": 30
     },
     "resolution": {
      "type": "array",
      "default": [
       1280,
       720
      ],
      "items": {
       "type": "integer"
      }
     },
     "color": {
      "type": "array",
      "default": [
       245,
       240,
       230
      ],
      "items": {
       "type": "integer"
      }
     },
     "accent": {
      "type": "array",
      "default": [
       240,
       170,
       60
      ],
      "items": {
       "type": "integer"
      }
     },
     "background": {
      "type": "array",
      "default": [
       16,
       20,
       28
      ],
      "items": {
       "type": "integer"
      }
     },
     "background_gradient": {
      "type": "boolean",
      "default": true
     },
     "size": {
      "type": "number",
      "default": 0.11,
      "description": "title height as a fraction of the frame"
     },
     "font": {
      "type": "string",
      "description": "a .ttf/.otf in the workspace (default Inter/DejaVu)"
     }
    }
   },
   "keywords": [
    "title card",
    "title",
    "intro card",
    "logo reveal"
   ]
  },
  "assemble": {
   "summary": "Edit clips and stills into one MP4 with crossfades (any FFmpeg xfade transition) and an optional music bed.",
   "requires": [
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "clips"
    ],
    "properties": {
     "clips": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "path"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "seconds": {
         "type": "number"
        }
       }
      }
     },
     "music": {
      "type": "string"
     },
     "transition": {
      "type": "string",
      "default": "fade",
      "enum": [
       "fade",
       "fadeblack",
       "dissolve",
       "wipeleft",
       "slideleft",
       "circleopen",
       "smoothleft",
       "zoomin"
      ]
     },
     "crossfade": {
      "type": "number",
      "default": 0.5,
      "minimum": 0.05,
      "maximum": 3
     },
     "resolution": {
      "type": "array",
      "default": [
       1280,
       720
      ],
      "items": {
       "type": "integer"
      }
     },
     "fps": {
      "type": "integer",
      "default": 30
     }
    }
   },
   "keywords": [
    "trailer",
    "teaser",
    "edit together",
    "montage",
    "cut together"
   ]
  },
  "capture": {
   "summary": "Record gameplay of a local web game with scripted input (Playwright video → MP4).",
   "requires": [
    "browser",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "target"
    ],
    "properties": {
     "target": {
      "type": "string"
     },
     "entry": {
      "type": "string"
     },
     "steps": {
      "type": "array",
      "default": [
       {
        "wait": 3000
       }
      ],
      "items": {
       "type": "object"
      }
     },
     "resolution": {
      "type": "array",
      "default": [
       1280,
       720
      ],
      "items": {
       "type": "integer"
      }
     },
     "wait_ms": {
      "type": "integer",
      "default": 500
     }
    }
   },
   "keywords": [
    "capture",
    "record gameplay",
    "screen recording",
    "gameplay video"
   ]
  }
 },
 "examples": [
  {
   "ask": "A golden-hour orbit of the island for the trailer",
   "call": {
    "action": "shot",
    "params": {
     "input": "island.glb",
     "move": "orbit",
     "lighting": "golden_hour",
     "duration": 6
    }
   }
  },
  {
   "ask": "Title card 'TIDEBREAKERS'",
   "call": {
    "action": "title_card",
    "params": {
     "text": "TIDEBREAKERS",
     "subtitle": "Set sail",
     "style": "rise"
    }
   }
  },
  {
   "ask": "Cut the shots and the title into a teaser with the theme music",
   "call": {
    "action": "assemble",
    "params": {
     "clips": [
      {
       "path": "title.mp4"
      },
      {
       "path": "orbit.mp4"
      }
     ],
     "music": "theme.ogg"
    }
   }
  }
 ],
 "limits": [
  "Cycles on CPU: ~0.5–3 s per frame at 640×360/12 samples; long or 4K shots take minutes to hours (use render resolution/samples to trade quality for time).",
  "EEVEE needs a GPU/OpenGL context and is not used headless.",
  "Kdenlive/MLT are not driven: FilmCraft is GITCRAFT's NLE for hand editing; assemble covers scripted cuts."
 ]
}
