{
 "name": "materialcraft",
 "version": "1.0.0",
 "title": "MaterialCraft — PBR materials and shaders",
 "summary": "Seamless procedural PBR materials (21 kinds: stone, cobblestone, brick, tiles, wood, planks, bark, metal, brushed metal, rust, fabric, leather, sand, grass, dirt, ice, lava, water, marble, concrete, snow) with dirt/moss/wear/wet weathering and a toon style; glTF metallic-roughness map sets (basecolor, normal GL/DX, roughness, metallic, AO, 16-bit height, packed ORM, emission), a sample sphere GLB, a three.js render and seam checks; seamless-izing of any image; toon gradient ramps; swatch sheets.",
 "keywords": [
  "material",
  "materials",
  "texture",
  "textures",
  "pbr",
  "shader",
  "seamless",
  "tileable",
  "tiling",
  "normal map",
  "roughness",
  "albedo",
  "basecolor",
  "rust",
  "corrosion",
  "weathering",
  "weathered",
  "dirt",
  "moss",
  "stone",
  "cobblestone",
  "brick",
  "wood",
  "planks",
  "metal",
  "fabric",
  "leather",
  "sand",
  "grass",
  "ice",
  "lava",
  "marble",
  "concrete",
  "toon",
  "cel",
  "toon ramp",
  "gradient map"
 ],
 "output_license": "Generated by GITCRAFT; owned by the requesting project",
 "tools": {
  "studio_materials": {
   "name": "GITCRAFT MaterialCraft generators",
   "license": "same as GITCRAFT",
   "version": "1.0",
   "source": "studio/departments/materialcraft/materials.py"
  },
  "numpy": {
   "name": "NumPy",
   "license": "BSD-3-Clause",
   "version": "2.5.4"
  },
  "three": {
   "name": "three.js r170 (render check)",
   "license": "MIT",
   "version": "0.170.0"
  },
  "gltf_validator": {
   "name": "Khronos glTF-Validator",
   "license": "Apache-2.0",
   "version": "2.0.0-dev.3.10"
  },
  "cc0_sources": {
   "name": "CC0 libraries: Poly Haven (api.polyhaven.com) and ambientCG (ambientcg.com)",
   "license": "CC0-1.0 (assets); GITCRAFT client code",
   "version": "API v1 / v2",
   "source": "studio/core/sources.py"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "three": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/three",
   "license": "MIT",
   "install": "scripts/install-studio.sh"
  },
  "gltf_validator": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/gltf-validator",
   "license": "Apache-2.0",
   "install": "scripts/install-studio.sh"
  },
  "browser": {
   "kind": "playwright",
   "license": "Apache-2.0 (Playwright), BSD (Chromium)",
   "install": "npm i -g playwright && npx playwright install chromium"
  },
  "cc0_sources": {
   "kind": "hosts",
   "hosts": [
    "api.polyhaven.com",
    "dl.polyhaven.org",
    "ambientcg.com",
    "acg-download.struffelproductions.com"
   ],
   "license": "CC0-1.0",
   "install": "GITCRAFT setup adds these hosts to ~/.gitcraft/allow-hosts for studiocraft; the environment's network policy must allow them too",
   "alternatives": [
    "procedural actions (materialcraft_generate, worldcraft_sky)"
   ]
  }
 },
 "actions": {
  "generate": {
   "summary": "Generate a seamless PBR material with optional weathering or toon style; maps, glTF/three.js material JSON, sample sphere GLB, render.",
   "requires": [
    "numpy",
    "pillow",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "material"
    ],
    "properties": {
     "material": {
      "type": "string",
      "enum": [
       "stone",
       "cobblestone",
       "brick",
       "wood",
       "planks",
       "metal",
       "brushed_metal",
       "rust",
       "fabric",
       "leather",
       "sand",
       "grass",
       "dirt",
       "tiles",
       "ice",
       "lava",
       "water",
       "marble",
       "concrete",
       "bark",
       "snow"
      ]
     },
     "resolution": {
      "type": "integer",
      "default": 512,
      "enum": [
       128,
       256,
       512,
       1024,
       2048
      ]
     },
     "scale": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.25,
      "maximum": 4,
      "description": "feature size multiplier (bigger = more, smaller features)"
     },
     "color": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "description": "tint [r, g, b] 0..255 (e.g. from the project palette)"
     },
     "dirt": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
     },
     "moss": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
     },
     "wear": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
     },
     "wet": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
     },
     "style": {
      "type": "string",
      "default": "pbr",
      "enum": [
       "pbr",
       "toon"
      ]
     },
     "toon_bands": {
      "type": "integer",
      "default": 4,
      "minimum": 2,
      "maximum": 8
     },
     "normal_strength": {
      "type": "number",
      "default": 4.0,
      "minimum": 0.1,
      "maximum": 20
     },
     "normal_convention": {
      "type": "string",
      "default": "opengl",
      "enum": [
       "opengl",
       "directx"
      ]
     },
     "tile_meters": {
      "type": "number",
      "default": 2.0,
      "description": "real-world size one tile represents"
     }
    }
   },
   "keywords": [
    "material",
    "texture",
    "pbr",
    "rusty",
    "weathered",
    "mossy"
   ]
  },
  "seamless": {
   "summary": "Make an existing texture tileable (offset + feathered cross blend) and measure the seam before/after.",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string"
     },
     "blend": {
      "type": "number",
      "default": 0.25,
      "minimum": 0.05,
      "maximum": 0.9
     }
    }
   },
   "keywords": [
    "make seamless",
    "make it tile",
    "tileable",
    "seamless texture"
   ]
  },
  "toon_ramp": {
   "summary": "A toon/cel shading gradient ramp texture.",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "properties": {
     "bands": {
      "type": "integer",
      "default": 3,
      "minimum": 2,
      "maximum": 8
     },
     "shadow": {
      "type": "number",
      "default": 0.35,
      "minimum": 0,
      "maximum": 1
     },
     "soft": {
      "type": "boolean",
      "default": false
     },
     "width": {
      "type": "integer",
      "default": 256
     },
     "height": {
      "type": "integer",
      "default": 4
     },
     "tint": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     }
    }
   },
   "keywords": [
    "toon ramp",
    "gradient map",
    "cel shading",
    "toon shader"
   ]
  },
  "library": {
   "summary": "A swatch sheet of several materials for look development.",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "properties": {
     "materials": {
      "type": "array",
      "default": [
       "stone",
       "cobblestone",
       "brick",
       "planks",
       "rust",
       "brushed_metal",
       "fabric",
       "leather",
       "sand",
       "grass",
       "ice",
       "lava"
      ],
      "items": {
       "type": "string"
      }
     },
     "resolution": {
      "type": "integer",
      "default": 192
     }
    }
   },
   "keywords": [
    "swatches",
    "material swatches",
    "look development"
   ]
  },
  "fetch": {
   "summary": "A CC0 PBR material from Poly Haven or ambientCG by search words or id: downloaded (checksummed), normalised to the MaterialCraft map set (basecolor, normal, roughness, AO, height, glTF ORM), rendered on a sphere in three.js and seam-checked. Licence CC0, credit recorded.",
   "requires": [
    "numpy",
    "pillow",
    "cc0_sources",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "search words, e.g. 'fresh snow', 'mossy rock', 'rusty corrugated metal'"
     },
     "id": {
      "type": "string",
      "description": "exact asset id (Poly Haven ids are lower_case, e.g. snow_02; ambientCG ids look like Snow015)"
     },
     "source": {
      "type": "string",
      "enum": [
       "auto",
       "polyhaven",
       "ambientcg"
      ],
      "default": "auto"
     },
     "resolution": {
      "type": "string",
      "enum": [
       "1k",
       "2k",
       "4k"
      ],
      "default": "1k",
      "description": "1k suits phones; 2k/4k for close-ups"
     },
     "normal_convention": {
      "type": "string",
      "enum": [
       "opengl",
       "directx"
      ],
      "default": "opengl",
      "description": "three.js/glTF use OpenGL"
     },
     "list_only": {
      "type": "boolean",
      "default": false,
      "description": "only list matching CC0 materials (writes <name>.candidates.json)"
     },
     "candidates": {
      "type": "integer",
      "default": 6,
      "minimum": 1,
      "maximum": 20
     }
    }
   },
   "outputs": [
    "<name>_basecolor/_normal/_roughness/_ao/_height (library files, not recompressed)",
    "<name>_orm.png",
    "<name>.material.json",
    "<name>_sphere.glb",
    "<name>_render.png",
    "<name>_tiled2x2.png"
   ],
   "keywords": [
    "poly haven",
    "polyhaven",
    "ambientcg",
    "cc0 texture",
    "cc0 material",
    "download texture",
    "real texture",
    "photo texture",
    "scanned material",
    "free texture",
    "cc0",
    "download",
    "photo",
    "photoscanned",
    "real material"
   ]
  }
 },
 "examples": [
  {
   "ask": "Mossy cobblestone for the castle courtyard",
   "call": {
    "action": "generate",
    "params": {
     "material": "cobblestone",
     "moss": 0.5,
     "dirt": 0.3
    }
   }
  },
  {
   "ask": "Rusty metal panels at 1K",
   "call": {
    "action": "generate",
    "params": {
     "material": "rust",
     "resolution": 1024,
     "wear": 0.4
    }
   }
  },
  {
   "ask": "Make this photo texture tile",
   "call": {
    "action": "seamless",
    "params": {
     "input": "assets/textures/wall.jpg"
    }
   }
  }
 ],
 "limits": [
  "Procedural, not scanned: for photoreal surfaces use CC0 scanned sets (ambientCG, Poly Haven) downloaded by a person; MaterialCraft can make those seamless and pack ORM maps.",
  "Material Maker (MIT) node graphs are not driven: it has no headless CLI here (deferred)."
 ]
}
