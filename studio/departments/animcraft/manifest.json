{
 "name": "animcraft",
 "version": "1.0.0",
 "title": "AnimCraft — rigging and animation",
 "summary": "Automatic rigging (humanoid, quadruped, chain/tentacle/tail) from mesh landmarks with heat-map skin weights (Mixamo bone names optional); procedural clips (idle, walk, run, wave, jump; quadruped walk/run/idle; chain wave/slither/sway/curl; object bob/spin/hover/squash/shake); world-space retargeting between rigs with different names and proportions (BVH, FBX, GLB sources); rigid-body physics drops baked to keyframes; sprite sheets from 3D clips (N directions) or frame folders; playback verification in three.js.",
 "keywords": [
  "rig",
  "rigging",
  "auto rig",
  "autorig",
  "skin",
  "skinning",
  "weights",
  "skeleton",
  "armature",
  "animate",
  "animation",
  "animated",
  "walk cycle",
  "run cycle",
  "idle",
  "jump",
  "wave",
  "retarget",
  "retargeting",
  "mocap",
  "bvh",
  "mixamo",
  "creature",
  "tentacle",
  "tail",
  "quadruped",
  "physics",
  "ragdoll",
  "rigid body",
  "drop",
  "sprite sheet",
  "spritesheet",
  "sprites",
  "8 directions",
  "isometric sprites",
  "motion capture",
  "pose estimation",
  "video to animation"
 ],
 "output_license": "Generated by GITCRAFT; owned by the requesting project (retargeted motion keeps the licence of its source motion)",
 "tools": {
  "blender": {
   "name": "Blender 5.2 (bpy, MeshCraft's) — armatures, heat-map weights, Bullet rigid bodies, Cycles, BVH/FBX/glTF I/O",
   "license": "GPL-2.0-or-later (outputs are not covered)",
   "version": "5.2.3"
  },
  "studio_anim": {
   "name": "GITCRAFT AnimCraft (landmark rigging, procedural clips, world-space retarget)",
   "license": "same as GITCRAFT",
   "version": "1.0",
   "source": "studio/departments/animcraft/bpy_anim.py"
  },
  "three": {
   "name": "three.js r170 (playback check)",
   "license": "MIT",
   "version": "0.170.0"
  },
  "gltf_validator": {
   "name": "Khronos glTF-Validator",
   "license": "Apache-2.0",
   "version": "2.0.0-dev.3.10"
  },
  "mediapipe": {
   "name": "MediaPipe Pose Landmarker (BlazePose GHUM 3D: 33 world landmarks per frame, CPU)",
   "license": "Apache-2.0 (code and models)",
   "version": "mediapipe 1.2.2, pose_landmarker_full/heavy float16 v1",
   "source": "https://ai.google.dev/edge/mediapipe/solutions/vision/pose_landmarker"
  },
  "studio_mocap": {
   "name": "GITCRAFT landmark → humanoid BVH solver (median bone lengths, hip/chest frames, limb swings, Euler ZXY; own BVH reader + FK check)",
   "license": "same as GITCRAFT",
   "version": "1.0",
   "source": "studio/departments/animcraft/mocap_bvh.py"
  },
  "unirig": {
   "name": "UniRig (learned skeleton + skinning prediction, Articulation-XL2.0 checkpoint)",
   "license": "MIT (code and weights)",
   "version": "main @ 6793c66",
   "source": "https://github.com/VAST-AI-Research/UniRig"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "blender": {
   "kind": "blender",
   "license": "GPL-2.0-or-later",
   "install": "scripts/install.sh meshcraft"
  },
  "three": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/three",
   "license": "MIT",
   "install": "scripts/install-studio.sh"
  },
  "gltf_validator": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/gltf-validator",
   "license": "Apache-2.0",
   "install": "scripts/install-studio.sh"
  },
  "browser": {
   "kind": "playwright",
   "license": "Apache-2.0 (Playwright), BSD (Chromium)",
   "install": "npm i -g playwright && npx playwright install chromium"
  },
  "mediapipe": {
   "kind": "venv",
   "python": "{STUDIO_HOME}/mocap-venv/bin/python",
   "module": "mediapipe",
   "license": "Apache-2.0",
   "files": [
    "{STUDIO_HOME}/models/mediapipe/pose_landmarker_full.task",
    "{STUDIO_HOME}/models/mediapipe/pose_landmarker_heavy.task"
   ],
   "install": "scripts/install-studio.sh mocap",
   "alternatives": [
    "Mixamo (manual upload/download, no API)",
    "hand-keyed clips: animcraft_animate"
   ],
   "system_libs": [
    "EGL",
    "GLESv2"
   ],
   "system_install": "apt-get install libegl1 libgles2"
  },
  "ffmpeg": {
   "kind": "binary",
   "bin": "ffmpeg",
   "version_cmd": [
    "ffmpeg",
    "-version"
   ],
   "license": "LGPL/GPL",
   "install": "apt-get install ffmpeg (or brew install ffmpeg)"
  },
  "gpu": {
   "kind": "gpu",
   "license": "n/a",
   "install": "a machine with an NVIDIA GPU (≥ 8 GB VRAM)"
  },
  "unirig": {
   "kind": "venv",
   "python": "{STUDIO_HOME}/unirig/.venv/bin/python",
   "module": "torch",
   "license": "MIT",
   "files": [
    "{STUDIO_HOME}/unirig/launch/inference/generate_skeleton.sh"
   ],
   "install": "scripts/install-studio.sh unirig  (GPU machines only: CUDA PyTorch, spconv, torch_scatter, flash-attn; checkpoint from huggingface.co)",
   "alternatives": [
    "animcraft_autorig (landmark rig + Blender heat weights, CPU)",
    "Mixamo auto-rigger (manual upload)"
   ]
  }
 },
 "actions": {
  "demo_character": {
   "summary": "A manifold T-pose test mesh (humanoid, quadruped or chain) to rig and animate.",
   "requires": [
    "blender",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string",
      "default": "humanoid",
      "enum": [
       "humanoid",
       "quadruped",
       "chain"
      ]
     },
     "height": {
      "type": "number",
      "default": 1.8,
      "minimum": 0.2,
      "maximum": 10,
      "description": "humanoid height in metres"
     }
    }
   },
   "keywords": [
    "test character",
    "demo character",
    "placeholder character",
    "test mesh"
   ]
  },
  "autorig": {
   "summary": "Rig a mesh: skeleton from landmarks, heat-map weights (envelope fallback is reported), skinned GLB + .blend.",
   "requires": [
    "numpy",
    "blender",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string",
      "description": "mesh: .glb/.gltf/.fbx/.obj (humanoid in T- or A-pose facing -Y/forward)"
     },
     "rig": {
      "type": "string",
      "default": "humanoid",
      "enum": [
       "humanoid",
       "quadruped",
       "chain"
      ]
     },
     "naming": {
      "type": "string",
      "default": "gitcraft",
      "enum": [
       "gitcraft",
       "mixamo"
      ]
     },
     "segments": {
      "type": "integer",
      "default": 6,
      "minimum": 2,
      "maximum": 32,
      "description": "chain rigs: bone count"
     }
    }
   },
   "keywords": [
    "rig",
    "rigging",
    "auto rig",
    "auto-rig",
    "autorig",
    "skin weights",
    "skinning",
    "skeleton",
    "armature",
    "rig my"
   ]
  },
  "animate": {
   "summary": "Add procedural clips to a rigged GLB (by rig type) or to any object.",
   "requires": [
    "numpy",
    "blender",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "input",
     "clips"
    ],
    "properties": {
     "input": {
      "type": "string"
     },
     "clips": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "idle",
        "walk",
        "run",
        "wave",
        "jump",
        "slither",
        "sway",
        "curl",
        "bob",
        "spin",
        "hover",
        "squash",
        "shake"
       ]
      }
     },
     "frames": {
      "type": "integer",
      "default": 24,
      "minimum": 4,
      "maximum": 480
     },
     "fps": {
      "type": "integer",
      "default": 24
     }
    }
   },
   "keywords": [
    "walk cycle",
    "run cycle",
    "idle animation",
    "animate",
    "give it a walk",
    "procedural animation",
    "bob",
    "spin"
   ]
  },
  "retarget": {
   "summary": "Retarget a clip from a source armature (BVH/FBX/GLB) onto a target rig (auto bone map: Mixamo, GITCRAFT, common BVH names; override with bone_map).",
   "requires": [
    "numpy",
    "blender",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "source",
     "target"
    ],
    "properties": {
     "source": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "clip": {
      "type": "string"
     },
     "clip_name": {
      "type": "string"
     },
     "bone_map": {
      "type": "object",
      "description": "{target_bone: source_bone}"
     },
     "min_bones": {
      "type": "integer",
      "default": 10
     }
    }
   },
   "keywords": [
    "retarget",
    "retargeting",
    "bvh",
    "mixamo animation",
    "transfer animation"
   ]
  },
  "physics": {
   "summary": "Drop objects (primitives or meshes) with rigid-body physics; bake to an animated GLB.",
   "requires": [
    "blender",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "inputs": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "count": {
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "maximum": 100
     },
     "shape": {
      "type": "string",
      "default": "mixed",
      "enum": [
       "crate",
       "ball",
       "barrel",
       "mixed"
      ]
     },
     "spread": {
      "type": "number",
      "default": 1.0
     },
     "bounce": {
      "type": "number",
      "default": 0.3,
      "minimum": 0,
      "maximum": 1
     },
     "frames": {
      "type": "integer",
      "default": 72
     },
     "fps": {
      "type": "integer",
      "default": 24
     }
    }
   },
   "keywords": [
    "physics",
    "rigid body",
    "drop",
    "fall",
    "tumble",
    "ragdoll"
   ]
  },
  "spritesheet": {
   "summary": "Sprite sheets (+ Phaser/PixiJS atlas JSON + GIF) from a 3D clip in N directions, or from a folder of frames.",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "properties": {
     "input": {
      "type": "string"
     },
     "frames_dir": {
      "type": "string"
     },
     "clips": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "directions": {
      "type": "integer",
      "default": 4,
      "enum": [
       1,
       2,
       4,
       8
      ]
     },
     "frames": {
      "type": "integer",
      "default": 8,
      "minimum": 2,
      "maximum": 64
     },
     "size": {
      "type": "integer",
      "default": 128
     },
     "elevation": {
      "type": "number",
      "default": 30,
      "description": "camera elevation in degrees (30 ≈ isometric-ish, 0 = side view)"
     },
     "samples": {
      "type": "integer",
      "default": 8
     },
     "columns": {
      "type": "integer"
     },
     "fps": {
      "type": "integer",
      "default": 12
     }
    }
   },
   "keywords": [
    "sprites",
    "sprite sheet",
    "spritesheet",
    "directions",
    "8 direction",
    "4 direction",
    "isometric sprites",
    "frames"
   ]
  },
  "verify": {
   "summary": "Verify an animated GLB: Khronos validator + every clip moves the model in three.js.",
   "requires": [
    "numpy",
    "pillow",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string"
     }
    }
   },
   "keywords": [
    "verify animation",
    "check animation",
    "does it animate",
    "clips play"
   ]
  },
  "mocap": {
   "summary": "Motion capture from a video or photo: MediaPipe Pose world landmarks → smoothed humanoid BVH (checked by forward kinematics and Blender's importer), optionally retargeted onto a rigged GLB.",
   "requires": [
    "numpy",
    "pillow",
    "mediapipe",
    "blender"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string",
      "description": "a video (mp4/mov/webm/mkv/avi/gif), an image, or a folder of images (frames in name order)"
     },
     "fps": {
      "type": "integer",
      "default": 30,
      "minimum": 1,
      "maximum": 60,
      "description": "sampling rate for video, frame rate of the BVH"
     },
     "max_frames": {
      "type": "integer",
      "default": 600,
      "minimum": 1,
      "maximum": 5000
     },
     "model": {
      "type": "string",
      "enum": [
       "full",
       "heavy"
      ],
      "default": "full",
      "description": "heavy is ~3x slower and steadier"
     },
     "smoothing": {
      "type": "integer",
      "default": 5,
      "minimum": 1,
      "maximum": 31,
      "description": "moving-average window in frames (1 = raw)"
     },
     "hold_seconds": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.1,
      "maximum": 10,
      "description": "single image: ease from rest into the pose over this long"
     },
     "target": {
      "type": "string",
      "description": "rigged GLB/FBX/blend to retarget the capture onto (e.g. from animcraft_autorig)"
     },
     "clip_name": {
      "type": "string"
     }
    }
   },
   "outputs": [
    "<name>.bvh",
    "<name>.landmarks.json (raw world landmarks)",
    "<name>_overlay.png (landmarks on the frames + the BVH's own pose)",
    "with target: <name>_on_<target>.glb/.blend + clip previews"
   ],
   "keywords": [
    "mocap",
    "motion capture",
    "capture motion",
    "pose estimation",
    "video to animation",
    "animation from video",
    "bvh from video",
    "mediapipe",
    "pose from photo",
    "video to bvh",
    "dance video",
    "into a bvh",
    "pose like",
    "like this photo"
   ]
  },
  "autorig_ml": {
   "summary": "Learned auto-rigging with UniRig: any mesh (characters, animals, props) → predicted skeleton + skin weights, merged into a rigged GLB and checked in three.js. GPU machines only.",
   "requires": [
    "gpu",
    "unirig",
    "blender",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string",
      "description": "GLB/FBX/OBJ mesh"
     },
     "skin": {
      "type": "boolean",
      "default": true,
      "description": "also predict skin weights (else skeleton only, Blender heat weights)"
     },
     "timeout": {
      "type": "integer",
      "default": 1800,
      "minimum": 60,
      "maximum": 7200
     }
    }
   },
   "outputs": [
    "<name>.glb (rigged)",
    "<name>_skeleton.fbx",
    "<name>_engine.png"
   ],
   "keywords": [
    "unirig",
    "ml rigging",
    "learned rig",
    "rig any mesh",
    "quadruped rig",
    "creature rig"
   ]
  }
 },
 "examples": [
  {
   "ask": "Rig my character and give it idle and walk",
   "call": [
    {
     "action": "autorig",
     "params": {
      "input": "assets/hero.glb"
     }
    },
    {
     "action": "animate",
     "params": {
      "input": "<rigged.glb>",
      "clips": [
       "idle",
       "walk"
      ]
     }
    }
   ]
  },
  {
   "ask": "Put this Mixamo/mocap walk on my rig",
   "call": {
    "action": "retarget",
    "params": {
     "source": "walk.fbx",
     "target": "hero_rigged.glb"
    }
   }
  },
  {
   "ask": "8-direction sprites of the walk",
   "call": {
    "action": "spritesheet",
    "params": {
     "input": "hero_animated.glb",
     "clips": [
      "walk"
     ],
     "directions": 8
    }
   }
  }
 ],
 "limits": [
  "Landmark rigging expects a T/A-pose humanoid facing forward, a level quadruped, or a straight chain; unusual anatomy needs bone_map or a hand-placed rig.",
  "Procedural clips are clean blocking animation, not keyframed performance; mocap/Mixamo motion via retarget gives natural movement.",
  "Video mocap (MediaPipe/FreeMoCap) and UniRig/learned skinning are deferred: GPU or model downloads (docs/studio-acquisition.md).",
  "mocap is monocular: one person, root translation is not recovered (landmarks are hip-centred; height follows the lowest foot), depth is estimated, no finger or face capture; hands and toes are approximate",
  "autorig_ml (UniRig) needs an NVIDIA GPU with ≥ 8 GB VRAM and huggingface.co for its checkpoint; it is blocked on CPU-only machines"
 ]
}
