{
 "name": "audiocraft",
 "version": "1.0.0",
 "title": "AudioCraft — game audio",
 "summary": "Sound effects, seamless ambiences, adaptive multi-stem music with MIDI source, character dialogue (Kokoro-82M neural TTS, CPU), loop-point detection, trimming, EBU R128 loudness normalisation, layering and WAV/OGG/MP3/Opus/FLAC conversion.",
 "keywords": [
  "sound",
  "sfx",
  "sound effect",
  "audio",
  "music",
  "soundtrack",
  "theme",
  "song",
  "loop",
  "ambience",
  "ambient",
  "soundscape",
  "voice",
  "dialogue",
  "speech",
  "narration",
  "tts",
  "voice line",
  "normalize",
  "normalise",
  "loudness",
  "wav",
  "ogg",
  "mp3",
  "footstep",
  "explosion",
  "jingle",
  "stems",
  "adaptive music"
 ],
 "output_license": "Generated by GITCRAFT from no third-party samples; owned by the requesting project (Kokoro voice output: Apache-2.0 model, no restriction on generated audio)",
 "tools": {
  "studio_synth": {
   "name": "GITCRAFT Studio synth (sfx/ambience/music/loop finder)",
   "license": "same as GITCRAFT",
   "version": "1.0",
   "source": "studio/departments/audiocraft/synth.py"
  },
  "ffmpeg": {
   "name": "FFmpeg",
   "license": "LGPL-2.1+ (this Ubuntu build is configured --enable-gpl: GPL-2.0+)",
   "version": "system",
   "source": "https://ffmpeg.org",
   "note": "run as an external program; its licence does not extend to the media it writes"
  },
  "kokoro": {
   "name": "Kokoro-82M v1.0 via kokoro-onnx 0.6.1 + onnxruntime",
   "license": "Apache-2.0 (weights), MIT (kokoro-onnx, onnxruntime); phonemizer + espeak-ng are GPL-3.0",
   "version": "kokoro-v1.0.int8",
   "source": "https://github.com/thewh1teagle/kokoro-onnx",
   "note": "espeak-ng (GPL-3.0) is used for phonemisation as a runtime library in a separate venv; nothing GPL is committed or linked into GITCRAFT code; generated speech carries no licence obligation"
  },
  "ace_step": {
   "name": "ACE-Step 1.5 (text → music DiT, acestep-v15-turbo, 8 steps; LM off)",
   "license": "MIT (code and weights)",
   "version": "v0.1.8 (ace-step 1.5.0)",
   "source": "https://github.com/ace-step/ACE-Step-1.5"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "ffmpeg": {
   "kind": "binary",
   "bin": "ffmpeg",
   "version_cmd": [
    "ffmpeg",
    "-version"
   ],
   "license": "LGPL/GPL",
   "install": "apt-get install ffmpeg (or brew install ffmpeg)"
  },
  "kokoro": {
   "kind": "venv",
   "python": "{STUDIO_HOME}/voice-venv/bin/python",
   "module": "kokoro_onnx",
   "license": "Apache-2.0 / MIT",
   "files": [
    "{STUDIO_HOME}/models/kokoro/kokoro-v1.0.int8.onnx",
    "{STUDIO_HOME}/models/kokoro/voices-v1.0.bin"
   ],
   "install": "scripts/install-studio.sh voice",
   "alternatives": [
    "Piper TTS (GPL-3.0 piper1-gpl; voices from Hugging Face, per-voice licences)",
    "espeak-ng alone (GPL-3.0, robotic formant voice)"
   ]
  },
  "ace_step": {
   "kind": "venv",
   "python": "{STUDIO_HOME}/ace-step/.venv/bin/python",
   "module": "ace_step",
   "license": "MIT",
   "weights_dirs": [
    "{STUDIO_HOME}/ace-step/checkpoints/acestep-v15-turbo",
    "{STUDIO_HOME}/ace-step/checkpoints/vae",
    "{STUDIO_HOME}/ace-step/checkpoints/Qwen3-Embedding-0.6B"
   ],
   "install": "scripts/install-studio.sh music  (opt-in: ~10 GB with PyTorch; weights from huggingface.co, which the environment's network policy must allow)",
   "alternatives": [
    "audiocraft_music (GITCRAFT's own deterministic synth: loops and stems, no model)"
   ]
  }
 },
 "actions": {
  "sfx": {
   "summary": "Synthesise a game sound effect (seeded; several variations).",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "preset"
    ],
    "properties": {
     "preset": {
      "type": "string",
      "enum": [
       "coin",
       "jump",
       "laser",
       "explosion",
       "hit",
       "powerup",
       "blip",
       "footstep",
       "whoosh",
       "splash",
       "magic",
       "click",
       "alarm",
       "thud"
      ]
     },
     "variations": {
      "type": "integer",
      "default": 1,
      "minimum": 1,
      "maximum": 16
     },
     "variation": {
      "type": "number",
      "default": 0.15,
      "minimum": 0,
      "maximum": 0.6,
      "description": "how far each variation may drift (0 = identical)"
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string",
       "enum": [
        "wav",
        "ogg",
        "mp3",
        "opus",
        "flac"
       ]
      }
     }
    }
   },
   "outputs": [
    "wav",
    "ogg|mp3",
    "waveform png"
   ],
   "keywords": [
    "sound effect",
    "sfx",
    "pickup sound",
    "jump sound",
    "hit sound",
    "ui sound"
   ]
  },
  "ambience": {
   "summary": "A seamless looping soundscape.",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "kind"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "ocean",
       "wind",
       "rain",
       "forest",
       "cave",
       "fire",
       "night",
       "space",
       "city"
      ]
     },
     "seconds": {
      "type": "number",
      "default": 20,
      "minimum": 2,
      "maximum": 180
     },
     "stereo": {
      "type": "boolean",
      "default": true
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string"
      }
     }
    }
   },
   "outputs": [
    "wav with smpl loop",
    "ogg with LOOPSTART/LOOPLENGTH",
    "waveform png"
   ],
   "keywords": [
    "ambience",
    "ambient",
    "soundscape",
    "atmosphere"
   ]
  },
  "music": {
   "summary": "A loopable piece as sample-aligned stems (drums, bass, pad, lead, arp), a mixdown, a MIDI source and an adaptive-intensity manifest.",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "properties": {
     "mood": {
      "type": "string",
      "default": "adventure",
      "enum": [
       "heroic",
       "calm",
       "tense",
       "playful",
       "mysterious",
       "sad",
       "adventure"
      ]
     },
     "key": {
      "type": "string",
      "default": "D",
      "enum": [
       "C",
       "C#",
       "Db",
       "D",
       "D#",
       "Eb",
       "E",
       "F",
       "F#",
       "Gb",
       "G",
       "G#",
       "Ab",
       "A",
       "A#",
       "Bb",
       "B"
      ]
     },
     "bars": {
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "maximum": 64
     },
     "tempo": {
      "type": "integer",
      "minimum": 40,
      "maximum": 220
     },
     "layers": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "drums",
        "bass",
        "pad",
        "lead",
        "arp"
       ]
      }
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string"
      }
     }
    }
   },
   "outputs": [
    "stems/*.wav",
    "mix wav/ogg",
    ".mid",
    ".layers.json"
   ],
   "keywords": [
    "music",
    "soundtrack",
    "theme",
    "song",
    "adaptive music",
    "stems",
    "bgm"
   ]
  },
  "voice": {
   "summary": "Character dialogue with Kokoro-82M neural TTS on CPU (54 voices, 8 languages; blend two voices with 'a+b').",
   "requires": [
    "numpy",
    "ffmpeg",
    "kokoro"
   ],
   "params": {
    "type": "object",
    "required": [
     "lines"
    ],
    "properties": {
     "lines": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "text": {
         "type": "string"
        },
        "character": {
         "type": "string"
        },
        "voice": {
         "type": "string"
        },
        "speed": {
         "type": "number",
         "minimum": 0.5,
         "maximum": 2.0
        },
        "lang": {
         "type": "string"
        }
       }
      }
     },
     "voice": {
      "type": "string",
      "default": "am_adam",
      "description": "default voice, e.g. af_heart, am_michael, bf_emma, bm_george, af_bella+am_adam"
     },
     "cast": {
      "type": "object",
      "default": {},
      "description": "character → voice"
     },
     "speed": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.5,
      "maximum": 2.0
     },
     "lang": {
      "type": "string",
      "default": "en-us",
      "enum": [
       "en-us",
       "en-gb",
       "es",
       "fr-fr",
       "it",
       "pt-br",
       "hi",
       "ja",
       "cmn"
      ]
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string"
      }
     }
    }
   },
   "outputs": [
    "one wav/ogg per line",
    ".dialogue.json script"
   ],
   "alternatives": [
    "record the lines",
    "ElevenLabs/hosted TTS (paid; not acquired)"
   ],
   "keywords": [
    "voice",
    "dialogue",
    "voice lines",
    "speech",
    "narration",
    "tts",
    "say"
   ]
  },
  "process": {
   "summary": "Trim silence, cut, fade, resample, mono, and normalise (peak dBFS or two-pass EBU R128 LUFS).",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string"
     },
     "trim_silence": {
      "type": "boolean",
      "default": true
     },
     "silence_db": {
      "type": "number",
      "default": -50
     },
     "start": {
      "type": "number"
     },
     "end": {
      "type": "number"
     },
     "fade_in": {
      "type": "number",
      "default": 0
     },
     "fade_out": {
      "type": "number",
      "default": 0
     },
     "lufs": {
      "type": "number",
      "minimum": -40,
      "maximum": -5,
      "description": "e.g. -16 (web/mobile), -23 (broadcast)"
     },
     "true_peak": {
      "type": "number",
      "default": -1.5
     },
     "peak_db": {
      "type": "number",
      "maximum": 0
     },
     "sample_rate": {
      "type": "integer",
      "default": 44100,
      "enum": [
       22050,
       32000,
       44100,
       48000
      ]
     },
     "mono": {
      "type": "boolean",
      "default": false
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string"
      }
     }
    }
   },
   "keywords": [
    "normalize",
    "normalise",
    "loudness",
    "lufs",
    "trim",
    "fade"
   ]
  },
  "convert": {
   "summary": "Convert any audio to WAV/OGG/MP3/Opus/FLAC (loop markers carried over).",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string"
     },
     "formats": {
      "type": "array",
      "default": [
       "ogg",
       "mp3"
      ],
      "items": {
       "type": "string",
       "enum": [
        "wav",
        "ogg",
        "mp3",
        "opus",
        "flac"
       ]
      }
     },
     "sample_rate": {
      "type": "integer",
      "default": 44100
     }
    }
   },
   "keywords": [
    "convert",
    "to ogg",
    "to mp3",
    "transcode"
   ]
  },
  "loop": {
   "summary": "Find a loop point in existing audio (cross-correlation, zero-crossing snap), write a seamless loop file and a marked original.",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string"
     },
     "min_seconds": {
      "type": "number",
      "default": 4,
      "minimum": 0.5
     },
     "crossfade": {
      "type": "number",
      "default": 0.05,
      "minimum": 0,
      "maximum": 2
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string"
      }
     }
    }
   },
   "keywords": [
    "loop point",
    "make it loop",
    "seamless loop",
    "loop the",
    "music loop"
   ]
  },
  "layer": {
   "summary": "Mix stems (gain, offset, looping) into one track with a layering manifest.",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "stems"
    ],
    "properties": {
     "stems": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "path"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "gain_db": {
         "type": "number"
        },
        "offset": {
         "type": "number"
        },
        "loop": {
         "type": "boolean"
        }
       }
      }
     },
     "length": {
      "type": "number"
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string"
      }
     }
    }
   },
   "keywords": [
    "mix",
    "layer",
    "mixdown"
   ]
  },
  "analyze": {
   "summary": "Duration, peak, RMS, LUFS, true peak, clipping, silence, DC offset and loop seam of an audio file.",
   "requires": [
    "numpy",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string"
     }
    }
   },
   "keywords": [
    "analyze",
    "analyse",
    "measure",
    "loudness check"
   ]
  },
  "music_model": {
   "summary": "Opt-in neural music with ACE-Step 1.5: a prompt (and optional lyrics) → a full track, measured and encoded. Needs `install-studio.sh music`; a GPU makes it fast (CPU works, slowly).",
   "requires": [
    "numpy",
    "ffmpeg",
    "ace_step"
   ],
   "params": {
    "type": "object",
    "required": [
     "prompt"
    ],
    "properties": {
     "prompt": {
      "type": "string",
      "description": "style caption, e.g. 'upbeat chiptune boss battle, 160 bpm, square leads'"
     },
     "lyrics": {
      "type": "string",
      "description": "optional lyrics with [verse]/[chorus] tags; empty = instrumental"
     },
     "duration": {
      "type": "number",
      "default": 30,
      "minimum": 5,
      "maximum": 240
     },
     "bpm": {
      "type": "integer",
      "minimum": 40,
      "maximum": 240
     },
     "key": {
      "type": "string",
      "description": "e.g. 'C minor'"
     },
     "model": {
      "type": "string",
      "enum": [
       "acestep-v15-turbo"
      ],
      "default": "acestep-v15-turbo"
     },
     "steps": {
      "type": "integer",
      "default": 8,
      "minimum": 4,
      "maximum": 60
     },
     "formats": {
      "type": "array",
      "default": [
       "wav",
       "ogg"
      ],
      "items": {
       "type": "string"
      }
     },
     "timeout": {
      "type": "integer",
      "default": 3600,
      "minimum": 60,
      "maximum": 7200
     }
    }
   },
   "outputs": [
    "<name>.wav/.ogg",
    "<name>_waveform.png"
   ],
   "keywords": [
    "ace-step",
    "neural music",
    "ai music",
    "song",
    "lyrics",
    "vocals",
    "soundtrack from prompt"
   ]
  }
 },
 "examples": [
  {
   "ask": "Make three coin pickup sounds for my platformer",
   "call": {
    "action": "sfx",
    "params": {
     "preset": "coin",
     "variations": 3,
     "out_dir": "assets/audio/sfx"
    }
   }
  },
  {
   "ask": "A 30 second ocean ambience loop",
   "call": {
    "action": "ambience",
    "params": {
     "kind": "ocean",
     "seconds": 30
    }
   }
  },
  {
   "ask": "Adventure theme with layers I can bring in as the fight gets harder",
   "call": {
    "action": "music",
    "params": {
     "mood": "adventure",
     "key": "D",
     "bars": 8
    }
   }
  },
  {
   "ask": "Voice these two lines for the captain and the parrot",
   "call": {
    "action": "voice",
    "params": {
     "cast": {
      "captain": "bm_george",
      "parrot": "af_sky"
     },
     "lines": [
      {
       "character": "captain",
       "text": "Hoist the sails!"
      },
      {
       "character": "parrot",
       "text": "Squawk! Sails!",
       "speed": 1.3
      }
     ]
    }
   }
  }
 ],
 "limits": [
  "Music is procedural (a solid loopable bed with MIDI to refine), not a human composition or a generative-model track.",
  "Kokoro reads English best; other languages need espeak-ng's voices and may mispronounce names.",
  "ACE-Step and Stable Audio Open are deferred: they need a GPU and Hugging Face downloads (see docs/studio-acquisition.md).",
  "music_model (ACE-Step) is opt-in and needs its weights from huggingface.co; without a GPU it runs on CPU, minutes per 30 s; outputs are MIT-licensed model output (check vocals/lyrics for likeness)"
 ]
}
