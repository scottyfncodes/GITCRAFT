{
 "name": "testcraft",
 "version": "1.0.0",
 "title": "TestCraft \u2014 automated QA",
 "summary": "Browser QA for web games with Playwright + Chromium: smoke tests on desktop, phone and tablet emulation (errors, missing files, blank screens, overflow, canvas), scripted gameplay with assertions on game state and video capture, FPS / frame-time / heap profiling, visual regression (YIQ pixel diff, baselines), asset integrity (every file opened by format; GLBs through the Khronos validator; texture budgets), animation playback (GLB clips really move; sprite frames differ), the project's own Vitest/Jest suite, and HTML/JSON reports.",
 "keywords": [
  "test",
  "tests",
  "testing",
  "qa",
  "smoke test",
  "e2e",
  "playwright",
  "browser test",
  "screenshot",
  "screenshots",
  "visual regression",
  "visual diff",
  "baseline",
  "mobile",
  "viewport",
  "responsive",
  "fps",
  "frame rate",
  "performance",
  "profiling",
  "profile",
  "asset integrity",
  "validate assets",
  "animation playback",
  "vitest",
  "jest",
  "unit tests",
  "gameplay test",
  "capture",
  "gameplay capture",
  "test report"
 ],
 "output_license": "Reports generated by GITCRAFT; owned by the requesting project",
 "tools": {
  "playwright": {
   "name": "Playwright",
   "license": "Apache-2.0",
   "version": "preinstalled"
  },
  "chromium": {
   "name": "Chromium (headless)",
   "license": "BSD-3-Clause",
   "version": "preinstalled"
  },
  "studio_testcraft": {
   "name": "GITCRAFT TestCraft (diff, reports)",
   "license": "same as GITCRAFT",
   "version": "1.0"
  },
  "gltf_validator": {
   "name": "Khronos glTF-Validator",
   "license": "Apache-2.0",
   "version": "2.0.0-dev.3.10"
  },
  "three": {
   "name": "three.js r170",
   "license": "MIT",
   "version": "0.170.0"
  },
  "ffmpeg": {
   "name": "FFmpeg",
   "license": "LGPL/GPL",
   "version": "system"
  },
  "vitest": {
   "name": "the project's own Vitest/Jest",
   "license": "MIT",
   "version": "project"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "browser": {
   "kind": "playwright",
   "license": "Apache-2.0 (Playwright), BSD (Chromium)",
   "install": "npm i -g playwright && npx playwright install chromium"
  },
  "three": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/three",
   "license": "MIT",
   "install": "scripts/install-studio.sh"
  },
  "gltf_validator": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/gltf-validator",
   "license": "Apache-2.0",
   "install": "scripts/install-studio.sh"
  },
  "ffmpeg": {
   "kind": "binary",
   "bin": "ffmpeg",
   "license": "LGPL/GPL",
   "install": "apt-get install ffmpeg"
  }
 },
 "actions": {
  "smoke": {
   "summary": "Load a web game on several viewports; check errors, missing files, blank screens, overflow and canvas; screenshots + report.",
   "requires": [
    "numpy",
    "pillow",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "target"
    ],
    "properties": {
     "target": {
      "type": "string",
      "description": "the game folder (served as http://game.local/) or its HTML file"
     },
     "entry": {
      "type": "string"
     },
     "viewports": {
      "type": "array",
      "default": [
       "desktop",
       "phone",
       "tablet"
      ],
      "items": {
       "type": "string",
       "enum": [
        "desktop",
        "laptop",
        "phone",
        "phone_landscape",
        "android",
        "tablet"
       ]
      }
     },
     "wait_ms": {
      "type": "integer",
      "default": 1500,
      "minimum": 0,
      "maximum": 60000
     },
     "expect_canvas": {
      "type": "boolean",
      "default": true
     },
     "allow_console_errors": {
      "type": "boolean",
      "default": false,
      "description": "deprecated: never ignores console errors; unexplained console errors become ADVISORY (listed in the report) instead of failing"
     },
     "console_error_exceptions": {
      "type": "array",
      "default": [],
      "description": "narrow, documented console-error exceptions: [{pattern, reason, host?}]. pattern is a regex that must not match every message; reason is required; with host, the exception applies only in a run where that host was blocked. Never applies to page exceptions or missing files.",
      "items": {
       "type": "object",
       "properties": {
        "pattern": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        },
        "host": {
         "type": "string"
        }
       },
       "required": [
        "pattern",
        "reason"
       ]
      }
     }
    }
   },
   "keywords": [
    "smoke test",
    "does it load",
    "blank screen",
    "console errors",
    "viewport",
    "viewports",
    "responsive"
   ]
  },
  "play": {
   "summary": "Scripted gameplay: key presses/holds, clicks, taps, waits, screenshots, eval and assert on game state; optional video capture (WebM + MP4).",
   "requires": [
    "numpy",
    "pillow",
    "browser",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "target",
     "steps"
    ],
    "properties": {
     "target": {
      "type": "string"
     },
     "entry": {
      "type": "string"
     },
     "steps": {
      "type": "array",
      "items": {
       "type": "object"
      },
      "description": "[{hold:'ArrowRight', ms:800}, {press:'Space'}, {click:[x,y]}, {wait:500}, {screenshot:'after'}, {eval:'window.game.score', as:'score'}, {assert:'window.game.score > 0', name:'collects a coin'}, {click:'#add'}, {fill:'#amount', value:'12'}, {expect:'.row', text:'12'}]"
     },
     "viewports": {
      "type": "array",
      "default": [
       "desktop"
      ],
      "items": {
       "type": "string"
      }
     },
     "wait_ms": {
      "type": "integer",
      "default": 1000
     },
     "record_video": {
      "type": "boolean",
      "default": false
     },
     "min_change": {
      "type": "number",
      "default": 0.0005,
      "description": "0 turns the 'screen changed' check off (app feature checks judged by their own expect/assert steps)."
     }
    }
   },
   "keywords": [
    "gameplay test",
    "play test",
    "playtest",
    "press keys",
    "assert",
    "scripted input",
    "collision test"
   ]
  },
  "perf": {
   "summary": "Profile FPS, frame-time percentiles, long frames, JS heap and DOM size for N seconds (optionally while running steps), against budgets.",
   "requires": [
    "numpy",
    "pillow",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "target"
    ],
    "properties": {
     "target": {
      "type": "string"
     },
     "entry": {
      "type": "string"
     },
     "seconds": {
      "type": "number",
      "default": 5,
      "minimum": 1,
      "maximum": 120
     },
     "steps": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "viewports": {
      "type": "array",
      "default": [
       "desktop"
      ],
      "items": {
       "type": "string"
      }
     },
     "wait_ms": {
      "type": "integer",
      "default": 1000
     },
     "min_fps": {
      "type": "number",
      "default": 30
     },
     "max_p95_ms": {
      "type": "number",
      "default": 50
     },
     "max_heap_mb": {
      "type": "number"
     }
    }
   },
   "keywords": [
    "fps",
    "frame rate",
    "framerate",
    "performance",
    "profile",
    "profiling",
    "lag",
    "stutter",
    "frame time",
    "memory"
   ]
  },
  "visual_diff": {
   "summary": "Compare two screenshots, or snapshot a target against a baseline folder (created on first run).",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "properties": {
     "baseline": {
      "type": "string"
     },
     "current": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "entry": {
      "type": "string"
     },
     "baseline_dir": {
      "type": "string"
     },
     "viewports": {
      "type": "array",
      "default": [
       "desktop"
      ],
      "items": {
       "type": "string"
      }
     },
     "wait_ms": {
      "type": "integer",
      "default": 1500
     },
     "update_baseline": {
      "type": "boolean",
      "default": false
     },
     "threshold": {
      "type": "number",
      "default": 0.1,
      "minimum": 0,
      "maximum": 1
     },
     "max_mismatch": {
      "type": "number",
      "default": 0.001,
      "minimum": 0,
      "maximum": 1
     }
    }
   },
   "keywords": [
    "visual regression",
    "visual diff",
    "screenshot diff",
    "baseline",
    "pixel diff",
    "compare screenshots"
   ]
  },
  "assets": {
   "summary": "Open and validate every asset in a folder (images, audio, video, GLB via Khronos, Tiled maps, JSON\u2026), with a texture size budget.",
   "requires": [
    "numpy",
    "pillow",
    "gltf_validator"
   ],
   "params": {
    "type": "object",
    "required": [
     "folder"
    ],
    "properties": {
     "folder": {
      "type": "string"
     },
     "khronos": {
      "type": "boolean",
      "default": true
     },
     "max_texture": {
      "type": "integer",
      "default": 4096
     }
    }
   },
   "keywords": [
    "asset integrity",
    "validate assets",
    "broken assets",
    "texture budget",
    "corrupt"
   ]
  },
  "animation": {
   "summary": "Verify animation playback: every GLB clip moves the model in three.js, or a sprite atlas has distinct non-empty frames.",
   "requires": [
    "numpy",
    "pillow",
    "three",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "input"
    ],
    "properties": {
     "input": {
      "type": "string",
      "description": ".glb, or a TexturePacker/Phaser atlas .json"
     }
    }
   },
   "keywords": [
    "animation playback",
    "clips play",
    "sprite frames"
   ]
  },
  "unit": {
   "summary": "Run the project's own Vitest or Jest suite and report results (never installs into the project).",
   "requires": [],
   "params": {
    "type": "object",
    "required": [
     "project"
    ],
    "properties": {
     "project": {
      "type": "string"
     },
     "timeout": {
      "type": "integer",
      "default": 600
     }
    }
   },
   "keywords": [
    "vitest",
    "jest",
    "unit tests",
    "unit test"
   ]
  },
  "report": {
   "summary": "One HTML QA report from every studio record (.studio.json) under a folder.",
   "requires": [
    "numpy",
    "pillow"
   ],
   "params": {
    "type": "object",
    "required": [
     "folder"
    ],
    "properties": {
     "folder": {
      "type": "string"
     }
    }
   },
   "keywords": [
    "qa report",
    "test report"
   ]
  }
 },
 "examples": [
  {
   "ask": "Smoke-test my game on desktop and phone",
   "call": {
    "action": "smoke",
    "params": {
     "target": "dist/",
     "viewports": [
      "desktop",
      "phone"
     ]
    }
   }
  },
  {
   "ask": "Check walking right collects a coin",
   "call": {
    "action": "play",
    "params": {
     "target": "dist/",
     "steps": [
      {
       "hold": "ArrowRight",
       "ms": 1200
      },
      {
       "assert": "window.game.score > 0",
       "name": "collects a coin"
      }
     ],
     "record_video": true
    }
   }
  },
  {
   "ask": "Is it holding 30 fps?",
   "call": {
    "action": "perf",
    "params": {
     "target": "dist/",
     "seconds": 10,
     "min_fps": 30
    }
   }
  }
 ],
 "limits": [
  "Targets are local folders served through request interception: games that need a live backend or CDN are reported as blocked requests (the sandbox has no network).",
  "WebGL runs on SwiftShader (CPU): FPS is a relative measure.",
  "Physics/collision validation is through the game's own state (eval/assert steps) or LevelCraft's map solvers; there is no engine-agnostic physics probe."
 ]
}
