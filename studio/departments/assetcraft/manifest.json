{
 "name": "assetcraft",
 "version": "1.0.0",
 "title": "AssetCraft — asset management",
 "summary": "One asset catalogue for every project (SQLite in ~/.gitcraft/assetcraft): every department run registers its outputs with licence and provenance; scan existing projects; search across projects; versions on content change; exact and perceptual (dHash) duplicates; unused assets (not referenced by source); dependency tracing (glTF, Tiled, HTML/CSS); licence inventory with ATTRIBUTION.md and non-commercial flags; hash re-verification; hash-verified integration into a project (never overwriting silently); 3D-library sync; a browsable HTML catalogue.",
 "keywords": [
  "asset",
  "assets",
  "catalog",
  "catalogue",
  "asset library",
  "inventory",
  "duplicate",
  "duplicates",
  "unused",
  "unused assets",
  "license",
  "licence",
  "licenses",
  "attribution",
  "credits",
  "provenance",
  "version",
  "versions",
  "dependencies",
  "thumbnails",
  "find assets",
  "asset search",
  "integrate assets",
  "import assets"
 ],
 "output_license": "Reports generated by GITCRAFT",
 "tools": {
  "studio_catalog": {
   "name": "GITCRAFT asset catalogue (studio/core/catalog.py)",
   "license": "same as GITCRAFT",
   "version": "1.0"
  },
  "sqlite": {
   "name": "SQLite (Python standard library)",
   "license": "Public domain",
   "version": "stdlib"
  },
  "pillow": {
   "name": "Pillow (thumbnails, dHash)",
   "license": "MIT-CMU",
   "version": "11.3.0"
  },
  "ffmpeg": {
   "name": "FFmpeg (audio/video thumbnails)",
   "license": "LGPL/GPL",
   "version": "system"
  }
 },
 "dependencies": {
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  }
 },
 "actions": {
  "scan": {
   "summary": "Catalogue every asset under a folder (validated, hashed, thumbnailed; licences from sidecars or default_license).",
   "requires": [
    "pillow"
   ],
   "params": {
    "type": "object",
    "required": [
     "folder"
    ],
    "properties": {
     "folder": {
      "type": "string"
     },
     "project": {
      "type": "string"
     },
     "default_license": {
      "type": "string"
     },
     "formats": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "keywords": [
    "catalogue",
    "catalog",
    "scan assets",
    "index assets"
   ]
  },
  "register": {
   "summary": "Register specific files with licence, attribution, source and tags.",
   "requires": [
    "pillow"
   ],
   "params": {
    "type": "object",
    "required": [
     "files"
    ],
    "properties": {
     "files": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "source": {
      "type": "string"
     }
    }
   }
  },
  "search": {
   "summary": "Search the catalogue (text, kind, licence, project, department; history optional).",
   "requires": [],
   "params": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "image",
       "audio",
       "video",
       "model",
       "animation",
       "map",
       "document",
       "data",
       "other"
      ]
     },
     "project": {
      "type": "string"
     },
     "department": {
      "type": "string"
     },
     "history": {
      "type": "boolean",
      "default": false
     },
     "limit": {
      "type": "integer",
      "default": 100
     }
    }
   },
   "keywords": [
    "find asset",
    "search assets",
    "where is"
   ]
  },
  "get": {
   "summary": "One asset (by id or path) with its version history and optionally its dependencies.",
   "requires": [],
   "params": {
    "type": "object",
    "required": [
     "asset"
    ],
    "properties": {
     "asset": {
      "type": "string"
     },
     "dependencies": {
      "type": "boolean",
      "default": true
     }
    }
   }
  },
  "duplicates": {
   "summary": "Exact duplicates (SHA-256) and near-duplicate images (dHash Hamming distance).",
   "requires": [],
   "params": {
    "type": "object",
    "properties": {
     "project": {
      "type": "string"
     },
     "near": {
      "type": "boolean",
      "default": true
     },
     "threshold": {
      "type": "integer",
      "default": 5,
      "minimum": 0,
      "maximum": 20
     }
    }
   },
   "keywords": [
    "duplicate",
    "duplicates"
   ]
  },
  "unused": {
   "summary": "Catalogued assets of a project that no source file references.",
   "requires": [],
   "params": {
    "type": "object",
    "required": [
     "project"
    ],
    "properties": {
     "project": {
      "type": "string"
     }
    }
   },
   "keywords": [
    "unused",
    "unreferenced",
    "dead assets"
   ]
  },
  "dependencies": {
   "summary": "What files need to load (glTF buffers/images, Tiled tilesets/images, HTML/CSS urls) and which are missing.",
   "requires": [],
   "params": {
    "type": "object",
    "required": [
     "files"
    ],
    "properties": {
     "files": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "keywords": [
    "dependencies",
    "missing textures"
   ]
  },
  "license_report": {
   "summary": "Licence inventory + ATTRIBUTION.md; flags non-commercial/no-derivatives and copyleft assets and unknown licences.",
   "requires": [],
   "params": {
    "type": "object",
    "properties": {
     "project": {
      "type": "string"
     },
     "require_known": {
      "type": "boolean",
      "default": false
     }
    }
   },
   "keywords": [
    "license",
    "licence",
    "attribution",
    "credits"
   ]
  },
  "verify": {
   "summary": "Re-hash every catalogued file: missing or changed since registration.",
   "requires": [],
   "params": {
    "type": "object",
    "properties": {
     "project": {
      "type": "string"
     }
    }
   },
   "keywords": [
    "verify assets",
    "changed assets"
   ]
  },
  "integrate": {
   "summary": "Copy catalogued assets into a project folder with licence sidecars, hash-verified; never overwrites a different file unless replace=true.",
   "requires": [],
   "params": {
    "type": "object",
    "required": [
     "assets",
     "dest"
    ],
    "properties": {
     "assets": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "catalogue ids or paths"
     },
     "dest": {
      "type": "string"
     },
     "replace": {
      "type": "boolean",
      "default": false
     }
    }
   },
   "keywords": [
    "integrate",
    "copy into",
    "import into"
   ]
  },
  "sync_3d": {
   "summary": "Register every version of the shared 3D library (MeshCraft/ForgeCraft) with its licence and provenance.",
   "requires": [],
   "params": {
    "type": "object",
    "properties": {
     "library": {
      "type": "string",
      "description": "default $GITCRAFT_3D_LIBRARY"
     }
    }
   },
   "keywords": [
    "3d library"
   ]
  },
  "catalog_page": {
   "summary": "A self-contained HTML catalogue page with thumbnails (filter by query/kind/project/department).",
   "requires": [],
   "params": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "project": {
      "type": "string"
     },
     "department": {
      "type": "string"
     },
     "limit": {
      "type": "integer",
      "default": 500
     }
    }
   },
   "keywords": [
    "catalog page",
    "browse assets",
    "gallery"
   ]
  }
 },
 "examples": [
  {
   "ask": "Catalogue this game's assets",
   "call": {
    "action": "scan",
    "params": {
     "folder": "public/assets"
    }
   }
  },
  {
   "ask": "Which assets are unused?",
   "call": {
    "action": "unused",
    "params": {
     "project": "."
    }
   }
  },
  {
   "ask": "Make the credits file",
   "call": {
    "action": "license_report",
    "params": {
     "project": "."
    }
   }
  }
 ],
 "limits": [
  "Unused detection matches file names referenced in source text; assets loaded by computed names show as unused (review before deleting — AssetCraft never deletes).",
  "Near-duplicates are for raster images only."
 ]
}
