{
 "name": "levelcraft",
 "version": "1.0.0",
 "title": "LevelCraft — levels and maps",
 "summary": "Procedural dungeons (BSP rooms + corridors + doors), caves (cellular automata), completable platformer levels (jump-physics reachability solver), overworlds (biomes, A* roads with bridges between settlements, camps, resources) and towns (road grid, building plots with doors, plaza) — as Tiled TMJ maps with a generated tileset, entity/collision/navigation object layers, generic JSON, preview and a 3D blockout GLB, each solved and loaded in Phaser 3.",
 "keywords": [
  "level",
  "levels",
  "map",
  "maps",
  "tilemap",
  "tile map",
  "tiled",
  "tmj",
  "ldtk",
  "dungeon",
  "roguelike",
  "cave",
  "platformer",
  "platform level",
  "overworld",
  "world map",
  "road",
  "roads",
  "town",
  "village",
  "settlement",
  "city layout",
  "blockout",
  "greybox",
  "collision",
  "navigation",
  "navmesh",
  "enemy placement",
  "spawn",
  "loot"
 ],
 "output_license": "Generated by GITCRAFT; owned by the requesting project",
 "tools": {
  "studio_levels": {
   "name": "GITCRAFT LevelCraft generators and solvers",
   "license": "same as GITCRAFT",
   "version": "1.0",
   "source": "studio/departments/levelcraft/gen.py"
  },
  "numpy": {
   "name": "NumPy",
   "license": "BSD-3-Clause",
   "version": "2.5.4"
  },
  "phaser": {
   "name": "Phaser 3.90 (engine load check)",
   "license": "MIT",
   "version": "3.90.0"
  },
  "three": {
   "name": "three.js r170 (blockout render)",
   "license": "MIT",
   "version": "0.170.0"
  },
  "gltf_validator": {
   "name": "Khronos glTF-Validator",
   "license": "Apache-2.0",
   "version": "2.0.0-dev.3.10"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "phaser": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/phaser",
   "license": "MIT",
   "install": "scripts/install-studio.sh"
  },
  "three": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/three",
   "license": "MIT",
   "install": "scripts/install-studio.sh"
  },
  "gltf_validator": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/gltf-validator",
   "license": "Apache-2.0",
   "install": "scripts/install-studio.sh"
  },
  "browser": {
   "kind": "playwright",
   "license": "Apache-2.0 (Playwright), BSD (Chromium)",
   "install": "npm i -g playwright && npx playwright install chromium"
  }
 },
 "actions": {
  "generate": {
   "summary": "Generate, solve, export (Tiled TMJ + tileset + JSON + blockout GLB) and engine-check a level.",
   "requires": [
    "numpy",
    "pillow",
    "phaser",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "kind"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "dungeon",
       "cave",
       "platformer",
       "overworld",
       "settlement"
      ]
     },
     "width": {
      "type": "integer",
      "default": 64,
      "minimum": 24,
      "maximum": 512
     },
     "height": {
      "type": "integer",
      "default": 48,
      "minimum": 12,
      "maximum": 512
     },
     "tile_size": {
      "type": "integer",
      "default": 16,
      "enum": [
       8,
       16,
       24,
       32,
       48,
       64
      ]
     },
     "enemies": {
      "type": "number",
      "default": 1.0,
      "minimum": 0,
      "maximum": 5
     },
     "loot": {
      "type": "number",
      "default": 1.0,
      "minimum": 0,
      "maximum": 5
     },
     "min_room": {
      "type": "integer",
      "default": 5,
      "minimum": 3,
      "maximum": 20
     },
     "jump_height": {
      "type": "integer",
      "default": 4,
      "minimum": 1,
      "maximum": 12,
      "description": "platformer: max jump height in tiles"
     },
     "jump_distance": {
      "type": "integer",
      "default": 5,
      "minimum": 2,
      "maximum": 16,
      "description": "platformer: max horizontal jump in tiles"
     },
     "settlements": {
      "type": "integer",
      "default": 6,
      "minimum": 2,
      "maximum": 40
     },
     "block": {
      "type": "integer",
      "default": 10,
      "minimum": 7,
      "maximum": 24
     }
    }
   },
   "keywords": [
    "level",
    "map",
    "tilemap",
    "dungeon",
    "platformer",
    "overworld",
    "town",
    "blockout"
   ]
  }
 },
 "examples": [
  {
   "ask": "A roguelike dungeon floor",
   "call": {
    "action": "generate",
    "params": {
     "kind": "dungeon",
     "width": 64,
     "height": 48
    }
   }
  },
  {
   "ask": "A completable platformer level for a character that jumps 3 tiles",
   "call": {
    "action": "generate",
    "params": {
     "kind": "platformer",
     "width": 160,
     "height": 24,
     "jump_height": 3
    }
   }
  },
  {
   "ask": "An overworld with towns connected by roads",
   "call": {
    "action": "generate",
    "params": {
     "kind": "overworld",
     "width": 128,
     "height": 96
    }
   }
  }
 ],
 "limits": [
  "Exports Tiled TMJ (LDtk projects can import Tiled maps through its own importer); a native LDtk writer is deferred.",
  "Platformer physics is a tile-level model (jump height/distance, head room); verify feel in the game itself (TestCraft play).",
  "Tiles are a generated placeholder tileset; swap in the game's art by keeping the tile ids (tileset tile property `name`)."
 ]
}
