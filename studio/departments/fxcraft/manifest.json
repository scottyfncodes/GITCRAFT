{
 "name": "fxcraft",
 "version": "1.0.0",
 "title": "FXCraft — visual effects",
 "summary": "Game-ready effects: flipbook atlases from particle simulations (fire, smoke, magic, energy/portal, rain, snow loops that repeat exactly; explosion, sparks, dust, splash, lightning, debris one-shots) with Phaser/PixiJS atlas JSON, GIF and MP4 previews; portable emitter presets (.fx.json) with a dependency-free three.js runtime, played in three.js r170; Blender Voronoi destruction with baked rigid-body physics as an animated GLB.",
 "keywords": [
  "effect",
  "effects",
  "vfx",
  "fx",
  "particle",
  "particles",
  "fire",
  "flame",
  "torch",
  "smoke",
  "explosion",
  "explode",
  "sparks",
  "dust",
  "debris",
  "splash",
  "water splash",
  "magic",
  "spell",
  "energy",
  "portal",
  "lightning",
  "weather",
  "rain",
  "snow",
  "destruction",
  "shatter",
  "fracture",
  "break apart",
  "flipbook",
  "sprite sheet effect",
  "emitter"
 ],
 "output_license": "Generated by GITCRAFT; owned by the requesting project (fxcraft-particles.js may be copied into any project)",
 "tools": {
  "studio_fx": {
   "name": "GITCRAFT FXCraft simulations + fxcraft-particles.js runtime",
   "license": "same as GITCRAFT",
   "version": "1.0",
   "source": "studio/departments/fxcraft/"
  },
  "numpy": {
   "name": "NumPy",
   "license": "BSD-3-Clause",
   "version": "2.5.4"
  },
  "ffmpeg": {
   "name": "FFmpeg",
   "license": "LGPL/GPL",
   "version": "system"
  },
  "three": {
   "name": "three.js r170",
   "license": "MIT",
   "version": "0.170.0"
  },
  "gltf_validator": {
   "name": "Khronos glTF-Validator",
   "license": "Apache-2.0",
   "version": "2.0.0-dev.3.10"
  },
  "blender": {
   "name": "Blender 5.2 (bpy) — bmesh bisect fracture, Bullet rigid bodies",
   "license": "GPL-2.0-or-later (outputs are not covered)",
   "version": "5.2.3"
  }
 },
 "dependencies": {
  "numpy": {
   "kind": "python",
   "module": "numpy",
   "license": "BSD-3-Clause",
   "install": "scripts/install-studio.sh"
  },
  "pillow": {
   "kind": "python",
   "module": "PIL",
   "license": "MIT-CMU",
   "install": "scripts/install-studio.sh"
  },
  "ffmpeg": {
   "kind": "binary",
   "bin": "ffmpeg",
   "license": "LGPL/GPL",
   "install": "apt-get install ffmpeg"
  },
  "three": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/three",
   "license": "MIT",
   "install": "scripts/install-studio.sh"
  },
  "gltf_validator": {
   "kind": "node_module",
   "path": "{STUDIO_HOME}/node/node_modules/gltf-validator",
   "license": "Apache-2.0",
   "install": "scripts/install-studio.sh"
  },
  "browser": {
   "kind": "playwright",
   "license": "Apache-2.0 (Playwright), BSD (Chromium)",
   "install": "npm i -g playwright && npx playwright install chromium"
  },
  "blender": {
   "kind": "blender",
   "license": "GPL-2.0-or-later",
   "install": "scripts/install.sh meshcraft"
  }
 },
 "actions": {
  "flipbook": {
   "summary": "Simulate an effect into a flipbook atlas (+ atlas JSON, GIF, MP4), with loop/visibility checks.",
   "requires": [
    "numpy",
    "pillow",
    "ffmpeg"
   ],
   "params": {
    "type": "object",
    "required": [
     "effect"
    ],
    "properties": {
     "effect": {
      "type": "string",
      "enum": [
       "fire",
       "smoke",
       "magic",
       "energy",
       "rain",
       "snow",
       "explosion",
       "sparks",
       "dust",
       "splash",
       "lightning",
       "debris"
      ]
     },
     "frames": {
      "type": "integer",
      "default": 32,
      "minimum": 4,
      "maximum": 128
     },
     "frame_size": {
      "type": "integer",
      "default": 128,
      "enum": [
       64,
       96,
       128,
       192,
       256
      ]
     },
     "fps": {
      "type": "integer",
      "default": 24,
      "minimum": 4,
      "maximum": 60
     },
     "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
     },
     "color": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "description": "tint [r,g,b] for magic, energy, smoke, dust, lightning, debris, splash"
     },
     "intensity": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.1,
      "maximum": 2
     }
    }
   },
   "keywords": [
    "sprite sheet",
    "spritesheet",
    "flipbook",
    "atlas",
    "phaser",
    "pixi",
    "sprite"
   ]
  },
  "emitter": {
   "summary": "Flipbook + emitter preset (.fx.json) + fxcraft-particles.js runtime, played in three.js r170.",
   "requires": [
    "numpy",
    "pillow",
    "ffmpeg",
    "three",
    "browser"
   ],
   "params": {
    "type": "object",
    "required": [
     "effect"
    ],
    "properties": {
     "effect": {
      "type": "string",
      "enum": [
       "fire",
       "smoke",
       "magic",
       "energy",
       "rain",
       "snow",
       "explosion",
       "sparks",
       "dust",
       "splash",
       "lightning",
       "debris"
      ]
     },
     "frames": {
      "type": "integer",
      "default": 32
     },
     "frame_size": {
      "type": "integer",
      "default": 128
     },
     "fps": {
      "type": "integer",
      "default": 24
     },
     "columns": {
      "type": "integer"
     },
     "color": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "intensity": {
      "type": "number",
      "default": 1.0
     },
     "max_particles": {
      "type": "integer",
      "default": 256,
      "minimum": 1,
      "maximum": 20000
     },
     "overrides": {
      "type": "object",
      "description": "emitter fields: rate, burst, lifetime, speed, direction, spread_deg, gravity, size, alpha, area, drag"
     },
     "check_seconds": {
      "type": "number",
      "default": 2.0
     }
    }
   },
   "keywords": [
    "emitter",
    "particle system",
    "particles",
    "three.js effect",
    "in game effect",
    "torch"
   ]
  },
  "destruction": {
   "summary": "Voronoi-fracture a crate/pillar/wall/rock (or a mesh) and bake a rigid-body break-apart into an animated GLB + .blend.",
   "requires": [
    "blender",
    "three",
    "gltf_validator",
    "browser"
   ],
   "params": {
    "type": "object",
    "properties": {
     "input": {
      "type": "string",
      "description": "optional mesh (.glb/.fbx/.obj/.blend); otherwise `shape`"
     },
     "shape": {
      "type": "string",
      "default": "crate",
      "enum": [
       "crate",
       "pillar",
       "wall",
       "rock"
      ]
     },
     "size": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.1,
      "maximum": 20
     },
     "pieces": {
      "type": "integer",
      "default": 14,
      "minimum": 2,
      "maximum": 80
     },
     "force": {
      "type": "number",
      "default": 4.0,
      "minimum": 0,
      "maximum": 50
     },
     "frames": {
      "type": "integer",
      "default": 48,
      "minimum": 10,
      "maximum": 400
     },
     "fps": {
      "type": "integer",
      "default": 24
     },
     "color": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     }
    }
   },
   "keywords": [
    "destruction",
    "shatter",
    "fracture",
    "break apart",
    "breakable",
    "smash",
    "crumble"
   ]
  }
 },
 "examples": [
  {
   "ask": "A looping torch fire for the dungeon walls",
   "call": {
    "action": "emitter",
    "params": {
     "effect": "fire"
    }
   }
  },
  {
   "ask": "Explosion sprite sheet for Phaser",
   "call": {
    "action": "flipbook",
    "params": {
     "effect": "explosion",
     "frames": 24,
     "frame_size": 128
    }
   }
  },
  {
   "ask": "Make the crate shatter when hit",
   "call": {
    "action": "destruction",
    "params": {
     "shape": "crate",
     "pieces": 16
    }
   }
  }
 ],
 "limits": [
  "Flipbooks are 2D particle simulations, not volumetric fluid sims; Blender Mantaflow smoke/fire baking is deferred (minutes per effect on CPU).",
  "Destruction cells are convex; very concave meshes fracture by their convex cells.",
  "three.quarks (MIT) is the recommended richer three.js particle system if a game outgrows fxcraft-particles.js."
 ]
}
